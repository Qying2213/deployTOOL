# Install as /etc/loumai/company-management-production-database.env, root:root 0600.
# Use the SAME production database/endpoint as the main backend, but a separate
# non-owner DML role with NO CREATE, TEMP, role-management or migration privileges.
# Percent-encode URL credentials. Never put MIGRATION_DATABASE_URL here.
LOUMAI_DATABASE_PROFILE=cloud
LOUMAI_DATABASE_NAME=LOUMAI_PRODUCTION_DATABASE
DATABASE_URL=postgresql+psycopg://ADMIN_DML_USER:REPLACE_PASSWORD@postgres.production.example.com:5432/LOUMAI_PRODUCTION_DATABASE?sslmode=verify-full&sslrootcert=/etc/loumai/certs/tencentdb-ca.pem
