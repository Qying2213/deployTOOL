# Install as /etc/loumai/company-management-production.env, root:root 0600.
# Fill real values only on the server. Do not inherit backend.env or sms.env.
APP_ENVIRONMENT=production
ADMIN_JWT_SECRET_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_JWT_ALGORITHM=HS256
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=120
BACKEND_ALLOWED_HOSTS=admin.example.com
BACKEND_CORS_ORIGINS=https://admin.example.com
API_DOCS_ENABLED=false
SCHEMA_CHECK_ENABLED=true
FILE_STORAGE_PROVIDER=tencent_cos
TENCENT_COS_SECRET_ID=REPLACE_WITH_ADMIN_SCOPED_COS_ID
TENCENT_COS_SECRET_KEY=REPLACE_WITH_ADMIN_SCOPED_COS_KEY
TENCENT_COS_REGION=REPLACE_WITH_PRODUCTION_REGION
TENCENT_COS_BUCKET=REPLACE_WITH_PRODUCTION_BUCKET
ATTACHMENT_SIGNED_URL_EXPIRES_SECONDS=300
