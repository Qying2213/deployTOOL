def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def command(args, *, env=None, cwd=None, input=None, timeout=30, check=True):
    result = subprocess.run(
        [str(arg) for arg in args],
        env=env or ENV,
        cwd=cwd,
        input=input,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )
    # Python validation/library errors can contain URLs. Never echo child output
    # or configuration values on failure; operators use the protected server log.
    require(
        not check or result.returncode == 0,
        f"command failed: {Path(args[0]).name} (exit={result.returncode})",
    )
    return result.stdout.strip() if check else result


def secure_directory(path):
    path = Path(path)
    for current in (path, *path.parents):
        info = current.lstat()
        require(
            stat.S_ISDIR(info.st_mode)
            and info.st_uid == 0
            and not info.st_mode & 0o022,
            f"directory is not root-controlled: {current}",
        )


def secure_file(path, *, secret=False):
    path = Path(path)
    secure_directory(path.parent)
    info = path.lstat()
    require(
        stat.S_ISREG(info.st_mode)
        and info.st_uid == 0
        and not info.st_mode & 0o022
        and info.st_nlink == 1,
        f"file is not root-controlled: {path}",
    )
    if secret:
        require(
            info.st_gid == 0 and stat.S_IMODE(info.st_mode) == 0o600,
            f"secret must be root:root 0600: {path}",
        )


def parse_env(text):
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        require(
            separator and re.fullmatch(r"[A-Z][A-Z0-9_]*", key) and key not in values,
            "invalid or duplicate environment key",
        )
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        require(
            not any(char in value for char in ("\x00", "\r", "`", "$(")),
            "unsafe environment value",
        )
        values[key] = value
    return values


def read_env(path, *, secret=False):
    secure_file(path, secret=secret)
    return parse_env(path.read_text())


def list_value(raw):
    value = (
        json.loads(raw)
        if raw.startswith("[")
        else [item.strip() for item in raw.split(",") if item.strip()]
    )
    require(
        isinstance(value, list) and all(isinstance(item, str) for item in value),
        "invalid host/origin list",
    )
    return value


def validate_runtime_values(values, public_url, main):
    require(
        set(values) <= APP_KEYS | DB_KEYS,
        "admin environment contains unexpected credentials or fields",
    )
    require(
        values.get("APP_ENVIRONMENT") == "production"
        and values.get("API_DOCS_ENABLED") == "false"
        and values.get("SCHEMA_CHECK_ENABLED") == "true",
        "production app safety switches are not configured",
    )
    public = urlsplit(public_url)
    require(
        public.scheme == "https"
        and public.path == "/admin-api"
        and not public.query
        and not public.fragment
        and not public.username
        and not public.password
        and not public.port
        and re.fullmatch(r"[a-z0-9.-]+\.[a-z]{2,}", public.hostname or "")
        and not re.search(
            r"(^|[.-])(test|localhost|example|invalid)([.-]|$)", public.hostname or ""
        ),
        "invalid production admin URL",
    )
    try:
        ipaddress.ip_address(public.hostname)
    except ValueError:
        pass
    else:
        raise RuntimeError("production admin URL cannot be an IP")
    origin = f"https://{public.hostname}"
    require(
        list_value(values.get("BACKEND_ALLOWED_HOSTS", "")) == [public.hostname],
        "admin allowed host must match its own domain",
    )
    require(
        list_value(values.get("BACKEND_CORS_ORIGINS", "")) == [origin],
        "admin CORS must be its own HTTPS origin",
    )
    jwt = values.get("ADMIN_JWT_SECRET_KEY", "")
    require(
        len(jwt) >= 32 and not re.search(r"replace|change.me|example", jwt, re.I),
        "independent admin JWT secret is missing/placeholder",
    )
    require(
        values.get("FILE_STORAGE_PROVIDER") == "tencent_cos",
        "production admin must use Tencent COS",
    )
    for key in (
        "TENCENT_COS_SECRET_ID",
        "TENCENT_COS_SECRET_KEY",
        "TENCENT_COS_REGION",
        "TENCENT_COS_BUCKET",
    ):
        require(
            values.get(key)
            and not re.search(r"replace|change.me|example", values[key], re.I),
            f"missing production {key}",
        )
    require(
        values.get("LOUMAI_DATABASE_PROFILE") == "cloud",
        "production admin requires cloud database",
    )
    database = urlsplit(values.get("DATABASE_URL", ""))
    query = parse_qs(database.query)
    require(
        database.scheme == "postgresql+psycopg"
        and database.username
        and database.password
        and database.hostname == main.get("LOUMAI_BACKEND_CLOUD_DATABASE_HOST")
        and database.port == 5432
        and database.path == "/" + main.get("LOUMAI_BACKEND_DATABASE_NAME", "")
        and values.get("LOUMAI_DATABASE_NAME")
        == main.get("LOUMAI_BACKEND_DATABASE_NAME")
        and query == {"sslmode": ["verify-full"], "sslrootcert": [CA]},
        "admin database target or verified TLS differs from production business database",
    )


def trusted_executable(value):
    path = Path(value)
    require(
        path.is_absolute()
        and path.resolve().is_relative_to(Path("/opt/loumai-runtime")),
        "runtime must be inside /opt/loumai-runtime",
    )
    secure_file(path.resolve())
    require(os.access(path, os.X_OK), "runtime executable is missing")
    return str(path)


def systemd_value(name):
    return command(["/usr/bin/systemctl", "show", SERVICE, "-p", name, "--value"])


def contract(*, allow_recovery=False):
    config = read_env(CONFIG)
    require(
        set(config)
        == {
            "LOUMAI_COMPANY_ENVIRONMENT",
            "LOUMAI_COMPANY_PUBLIC_URL",
            "LOUMAI_COMPANY_BASE_PYTHON",
            "LOUMAI_COMPANY_UV",
        },
        "unexpected production helper configuration",
    )
    require(
        config["LOUMAI_COMPANY_ENVIRONMENT"] == "production",
        "not a production admin helper configuration",
    )
    main = read_env(MAIN_CONFIG)
    require(
        main.get("LOUMAI_BACKEND_ENVIRONMENT") == "production"
        and main.get("LOUMAI_BACKEND_REMOTE_ROOT") == str(MAIN_ROOT),
        "business backend is not production",
    )
    require(
        SERVICE in main.get("LOUMAI_BACKEND_AUXILIARY_DATABASE_SERVICES", "").split(),
        "admin writer is not registered in the main backend migration fence",
    )
    require(
        allow_recovery or not (MAIN_ROOT / ".migration-recovery-required").exists(),
        "business database recovery is required; admin start/deploy/rollback is blocked",
    )
    require(
        (MAIN_ROOT / "backend-current").is_symlink(),
        "initialize the business backend before deploying admin",
    )
    for directory in (ROOT, ROOT / "releases", ROOT / "incoming", MAIN_ROOT):
        secure_directory(directory)
    secure_file(HELPER)
    secure_file(Path("/etc/systemd/system") / SERVICE)
    secure_file(Path(CA))
    app = read_env(APP_ENV, secret=True)
    database = read_env(DB_ENV, secret=True)
    require(
        set(app) <= APP_KEYS and set(database) == DB_KEYS,
        "database and admin credentials must be isolated",
    )
    environment = {**app, **database}
    validate_runtime_values(environment, config["LOUMAI_COMPANY_PUBLIC_URL"], main)
    main_profile = read_env(
        Path("/etc/loumai/database-profiles/cloud.env"), secret=True
    )
    admin_role = urlsplit(environment["DATABASE_URL"]).username
    require(
        all(
            admin_role != urlsplit(main_profile.get(key, "")).username
            for key in ("DATABASE_URL", "MIGRATION_DATABASE_URL", "BACKUP_DATABASE_URL")
        ),
        "admin requires an independent DML database role",
    )
    identities = [
        pwd.getpwnam(user).pw_uid for user in (RUN_USER, BUILD_USER, DEPLOY_USER)
    ]
    require(
        0 not in identities and len(set(identities)) == 3,
        "admin, build and deploy require separate non-root UIDs",
    )
    require(
        systemd_value("User") == RUN_USER and systemd_value("Group") == RUN_USER,
        "unexpected admin service UID/GID",
    )
    require(
        systemd_value("FragmentPath") == f"/etc/systemd/system/{SERVICE}"
        and not systemd_value("DropInPaths"),
        "unreviewed admin systemd override",
    )
    env_files = re.findall(r"/[A-Za-z0-9._/-]+", systemd_value("EnvironmentFiles"))
    require(
        env_files == [str(APP_ENV), str(DB_ENV)],
        "admin systemd must load only its independent runtime credentials",
    )
    require(
        "loumai-db-ca" in systemd_value("SupplementaryGroups").split(),
        "admin service cannot read database CA",
    )
    require(
        systemd_value("WorkingDirectory") == str(ROOT / "current")
        and f"{HELPER} run" in systemd_value("ExecStart"),
        "admin service runner mismatch",
    )
    if current_target() == "NONE":
        require(
            systemd_value("ActiveState") in {"inactive", "failed"}
            and systemd_value("MainPID") == "0"
            and systemd_value("UnitFileState") == "disabled",
            "first admin release requires a stopped, disabled service",
        )
    config["python"] = trusted_executable(config["LOUMAI_COMPANY_BASE_PYTHON"])
    config["uv"] = trusted_executable(config["LOUMAI_COMPANY_UV"])
    command(["/usr/sbin/nginx", "-t"])
    return config, environment


def release_path(release_id):
    require(
        re.fullmatch(r"[0-9]{8}T[0-9]{6}Z-[a-f0-9]{10}", release_id),
        "invalid release ID",
    )
    return ROOT / "releases" / release_id / "backend"


def current_target():
    link = ROOT / "current"
    if not link.exists() and not link.is_symlink():
        return "NONE"
    require(link.is_symlink(), "admin current is not a symlink")
    target = link.resolve(strict=True)
    require(
        target == release_path(target.parent.name),
        "admin current escapes the release root",
    )
    return str(target)


@contextlib.contextmanager
def locks():
    handles = []
    try:
        for path in (MAIN_ROOT / ".backend-release.lock", ROOT / ".admin-release.lock"):
            secure_directory(path.parent)
            descriptor = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            handles.append(descriptor)
            info = os.fstat(descriptor)
            require(
                stat.S_ISREG(info.st_mode)
                and info.st_uid == 0
                and not info.st_mode & 0o022,
                "unsafe release lock",
            )
            deadline = time.monotonic() + 120
            while True:
                try:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    require(
                        time.monotonic() < deadline,
                        "another business/admin deployment is running",
                    )
                    time.sleep(0.2)
        yield
    finally:
        for descriptor in reversed(handles):
            os.close(descriptor)


def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            result.update(block)
    return result.hexdigest()


def unpack_archive(archive, destination):
    with tarfile.open(archive) as bundle:
        members = []
        total = 0
        for item in bundle:
            members.append(item)
            total += item.size
            require(
                len(members) <= 20000 and total <= 256 * 1024 * 1024,
                "archive exceeds limits",
            )
        seen = set()
        for item in members:
            parts = PurePosixPath(item.name).parts
            require(
                parts
                and parts[0] == "backend"
                and ".." not in parts
                and not item.name.startswith("/")
                and "\\" not in item.name
                and (item.isfile() or item.isdir())
                and not any(part.startswith(".") for part in parts)
                and not re.search(
                    r"\.(env|pem|key|p12|pfx|sql|db|sqlite|bak)$", item.name, re.I
                ),
                "archive contains unsafe paths, links or credentials",
            )
            require(item.name not in seen, "duplicate archive member")
            seen.add(item.name)
        for item in members:
            target = destination / item.name
            if item.isdir():
                target.mkdir(parents=True, exist_ok=True)
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                with target.open("xb") as output, bundle.extractfile(item) as source:
                    shutil.copyfileobj(source, output)
                target.chmod(0o644)


def verify_release(target, release_id):
    secure_directory(target)
    require(target.is_dir() and not target.is_symlink(), "invalid release directory")
    manifest = json.loads((target / "release.json").read_text())
    require(
        manifest.get("environment") == "production"
        and manifest.get("release_id") == release_id
        and re.fullmatch(r"[a-f0-9]{40}", manifest.get("commit", "")),
        "release is not a pinned production admin build",
    )
    expected = {}
    for line in (target / "SHA256SUMS").read_text().splitlines():
        match = re.fullmatch(r"([a-f0-9]{64})  ([A-Za-z0-9_./-]+)", line)
        require(match is not None, "invalid checksums manifest")
        hashed, name = match.groups()
        require(
            not name.startswith("/")
            and not any(part.startswith(".") for part in PurePosixPath(name).parts)
            and name not in expected,
            "unsafe/duplicate checksum path",
        )
        expected[name] = hashed
    actual = set()
    for path in target.rglob("*"):
        relative = path.relative_to(target)
        if relative.parts[0] == ".runtime":
            continue
        require(not path.is_symlink(), "source symlink is forbidden")
        if path.is_file() and relative.as_posix() != "SHA256SUMS":
            actual.add(relative.as_posix())
    require(actual == set(expected), "checksums do not cover the exact artifact")
    require(
        {"app/main.py", "pyproject.toml", "runtime-constraints.txt", "release.json"}
        <= actual,
        "incomplete admin release",
    )
    for name, hashed in expected.items():
        require(digest(target / name) == hashed, "release checksum mismatch")
    constraints = (target / "runtime-constraints.txt").read_text().splitlines()
    require(
        constraints
        and all(
            re.fullmatch(r"[A-Za-z0-9_.-]+==[A-Za-z0-9_.+!-]+", line)
            for line in constraints
        ),
        "runtime dependencies must be pinned (no URLs/options)",
    )


def run_as(user, args, *, environment=None, cwd=None, input=None, timeout=60):
    # runuser inherits a deliberately minimal environment; secrets never appear in argv.
    return command(
        ["/usr/sbin/runuser", "-u", user, "--", *args],
        env={**ENV, **(environment or {})},
        cwd=cwd,
        input=input,
        timeout=timeout,
    )


def build_runtime(target, config):
    runtime = target / ".runtime"
    runtime.mkdir(mode=0o755)
    builder = pwd.getpwnam(BUILD_USER)
    os.chown(runtime, builder.pw_uid, builder.pw_gid)
    build_env = {
        "UV_CACHE_DIR": str(runtime / "cache"),
        "PYTHONPYCACHEPREFIX": str(runtime / "pycache"),
    }
    run_as(
        BUILD_USER,
        [
            config["uv"],
            "--no-config",
            "venv",
            "--python",
            config["python"],
            str(runtime / "venv"),
        ],
        environment=build_env,
        cwd=target,
        timeout=180,
    )
    run_as(
        BUILD_USER,
        [
            config["uv"],
            "--no-config",
            "pip",
            "sync",
            "--python",
            str(runtime / "venv/bin/python"),
            "runtime-constraints.txt",
        ],
        environment=build_env,
        cwd=target,
        timeout=600,
    )
    run_as(
        BUILD_USER,
        [str(runtime / "venv/bin/python"), "-m", "compileall", "-q", "app"],
        environment=build_env,
        cwd=target,
    )
    for path in [runtime, *runtime.rglob("*")]:
        os.chown(path, 0, 0, follow_symlinks=False)
        if not path.is_symlink():
            path.chmod(0o755 if path.is_dir() or path.stat().st_mode & 0o111 else 0o644)


