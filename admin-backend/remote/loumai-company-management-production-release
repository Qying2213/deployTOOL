def probe_release(target, environment):
    verify_release(target, target.parent.name)
    require(
        (target / ".runtime/venv/bin/python").exists(), "release runtime is missing"
    )
    output = run_as(
        RUN_USER,
        [str(target / ".runtime/venv/bin/python"), "-"],
        environment=environment,
        cwd=target,
        input=PROBE,
    )
    require(
        output == "ADMIN_SCHEMA_AND_DML_ROLE=verified",
        "admin schema/limited database role probe failed",
    )


def switch_current(target):
    link = ROOT / "current"
    if target == "NONE":
        if link.is_symlink():
            link.unlink()
        return
    next_link = ROOT / f".current-next-{os.getpid()}"
    require(
        not next_link.exists() and not next_link.is_symlink(),
        "temporary current link exists",
    )
    next_link.symlink_to(target)
    os.replace(next_link, link)


def verify_process(target, environment, *, compare_credentials=True):
    require(systemd_value("ActiveState") == "active", "admin service not active")
    pid = systemd_value("MainPID")
    require(re.fullmatch(r"[1-9][0-9]*", pid), "invalid admin service PID")
    require(
        Path(f"/proc/{pid}/cwd").resolve() == Path(target),
        "admin is running a different release",
    )
    data = Path(f"/proc/{pid}/environ").read_bytes()
    actual = dict(
        item.decode().split("=", 1) for item in data.split(b"\0") if b"=" in item
    )
    if compare_credentials:
        require(
            all(actual.get(key) == value for key, value in environment.items()),
            "admin runtime credentials differ from configured production credentials",
        )
    else:
        for key in (
            "APP_ENVIRONMENT",
            "LOUMAI_DATABASE_PROFILE",
            "LOUMAI_DATABASE_NAME",
        ):
            require(
                actual.get(key) == environment.get(key),
                "admin is using a non-production database profile",
            )
        selected, running = (
            urlsplit(values.get("DATABASE_URL", "")) for values in (environment, actual)
        )
        require(
            (
                selected.scheme,
                selected.hostname,
                selected.port,
                selected.path,
                selected.query,
            )
            == (
                running.scheme,
                running.hostname,
                running.port,
                running.path,
                running.query,
            ),
            "running admin database differs from production target",
        )
    require(
        not (
            {"MIGRATION_DATABASE_URL", "BACKUP_DATABASE_URL", "JWT_SECRET_KEY"}
            & set(actual)
        ),
        "admin process inherited business/DDL credentials",
    )


def health(config, environment, target):
    public = config["LOUMAI_COMPANY_PUBLIC_URL"]
    host = urlsplit(public).hostname
    for attempt in range(12):
        try:
            for url, local in (
                ("http://127.0.0.1:8100/health", True),
                (public + "/health", False),
                (public + "/ready", False),
            ):
                args = [
                    "/usr/bin/curl",
                    "--fail",
                    "--silent",
                    "--show-error",
                    "--max-time",
                    "5",
                ]
                if local:
                    args += ["-H", f"Host: {host}"]
                body = json.loads(command([*args, url]))["data"]
                require(
                    body.get("status") == ("READY" if url.endswith("/ready") else "UP"),
                    "unexpected admin health response",
                )
                if url.endswith("/ready"):
                    require(
                        body.get("schema_compatible") is True,
                        "admin schema is incompatible",
                    )
                else:
                    require(
                        body.get("service") == "loumai-company-management",
                        "health endpoint is not admin",
                    )
            code = command(
                [
                    "/usr/bin/curl",
                    "-sS",
                    "--max-time",
                    "5",
                    "-o",
                    "/dev/null",
                    "-w",
                    "%{http_code}",
                    public + "/api/v1/admin-auth/me",
                ]
            )
            require(code == "401", "admin unauthenticated boundary is not 401")
            verify_process(target, environment)
            return
        except (RuntimeError, ValueError, KeyError):
            if attempt == 11:
                raise
            time.sleep(1)


def activate_target(target, previous, config, environment):
    probe_release(target, environment)
    switch_current(str(target))
    try:
        command(["/usr/bin/systemctl", "restart", SERVICE], timeout=90)
        health(config, environment, str(target))
        command(["/usr/bin/systemctl", "enable", SERVICE])
    except Exception:
        command(["/usr/bin/systemctl", "stop", SERVICE])
        switch_current(previous)
        if previous != "NONE":
            try:
                probe_release(Path(previous), environment)
                command(["/usr/bin/systemctl", "restart", SERVICE], timeout=90)
                health(config, environment, previous)
            except Exception:
                command(["/usr/bin/systemctl", "disable", "--now", SERVICE])
                raise RuntimeError(
                    "CRITICAL: previous admin release could not be restored; admin disabled, investigate manually"
                ) from None
        else:
            command(["/usr/bin/systemctl", "disable", "--now", SERVICE])
        raise RuntimeError(
            "admin activation failed; previous state restored; database was not changed"
        ) from None


def report(config, environment):
    print(f"HELPER_VERSION={VERSION}\nENVIRONMENT=production\nREMOTE_ROOT={ROOT}")
    print(
        f"PUBLIC_URL={config['LOUMAI_COMPANY_PUBLIC_URL']}\nCURRENT={current_target()}\nDATABASE_PROFILE=cloud"
    )
    print(f"UNIT={systemd_value('ActiveState')}")
    if current_target() != "NONE" and systemd_value("ActiveState") == "active":
        verify_process(current_target(), environment, compare_credentials=False)


def serve():
    require(
        os.getuid() == pwd.getpwnam(RUN_USER).pw_uid != 0,
        "run is only available to the admin service UID",
    )
    environment = {
        key: value for key, value in os.environ.items() if key in APP_KEYS | DB_KEYS
    }
    require(
        environment.get("APP_ENVIRONMENT") == "production"
        and environment.get("LOUMAI_DATABASE_PROFILE") == "cloud",
        "invalid service runtime environment",
    )
    target = current_target()
    require(target != "NONE", "admin is not initialized")
    python = str(Path(target) / ".runtime/venv/bin/python")
    os.chdir(target)
    # Main-backend migrations also restart this service. Recheck schema and role
    # on EVERY start, before allowing HTTP traffic, without needing root secrets.
    require(
        command(
            [python, "-"],
            env={**ENV, **environment},
            cwd=target,
            input=PROBE,
            timeout=60,
        )
        == "ADMIN_SCHEMA_AND_DML_ROLE=verified",
        "admin startup schema/role check failed",
    )
    os.execve(
        python,
        [
            python,
            "-m",
            "uvicorn",
            "app.main:app",
            "--host",
            "127.0.0.1",
            "--port",
            "8100",
            "--workers",
            "1",
            "--proxy-headers",
            "--forwarded-allow-ips",
            "127.0.0.1",
            "--no-access-log",
        ],
        {**ENV, **environment},
    )


def main(argv):
    if argv == ["run"]:
        serve()
        return
    require(os.geteuid() == 0, "release helper requires root via restricted sudo")
    os.umask(0o022)
    if argv == ["version"]:
        print(VERSION)
        return
    if argv == ["fingerprint"]:
        print(digest(Path(__file__)))
        return
    action = argv[0] if argv else ""
    counts = {
        "status": 1,
        "preflight": 1,
        "contract": 1,
        "restart": 2,
        "prepare": 3,
        "activate": 4,
        "rollback": 3,
        "check-release": 3,
    }
    require(
        action in counts and len(argv) == counts[action],
        "invalid command/argument count",
    )
    if action == "contract":
        # Read-only validation for the main backend while it owns the migration
        # lock/recovery marker. This action cannot start/stop services or mutate data.
        contract(allow_recovery=True)
        print("PRODUCTION_ADMIN_CONTRACT=verified")
        return
    if action == "restart":
        with locks():
            config, environment = contract()
            previous = current_target()
            require(
                previous != "NONE" and previous == argv[1],
                "current changed or admin is not initialized",
            )
            activate_target(Path(previous), previous, config, environment)
            print(f"RESTARTED={previous}")
        return
    if action in {"status", "preflight"}:
        config, environment = contract()
        report(config, environment)
        return
    release_id, *arguments = argv[1:]
    target = release_path(release_id)
    if action == "check-release":
        config, environment = contract()
        require(
            current_target() == arguments[0] != "NONE",
            "current changed or not initialized",
        )
        probe_release(target, environment)
        print(f"RELEASE_VALID={target}")
        return
    with locks():
        config, environment = contract()
        previous = current_target()
        expected = arguments[-1]
        require(previous == expected, "current changed; repeat preflight")
        incoming = ROOT / "incoming" / f"{release_id}.partial"
        if action == "prepare":
            require(
                not incoming.exists()
                and not incoming.is_symlink()
                and not target.parent.exists(),
                "staging/release already exists",
            )
            incoming.mkdir(mode=0o700)
            owner = pwd.getpwnam(DEPLOY_USER)
            os.chown(incoming, owner.pw_uid, owner.pw_gid)
            print(f"PREPARED={incoming}")
            return
        if action == "rollback":
            require(
                previous != "NONE" and previous != str(target),
                "no current release or already current",
            )
            activate_target(target, previous, config, environment)
            print(f"ROLLED_BACK={target}")
            return
        archive_sha = arguments[0]
        require(re.fullmatch(r"[a-f0-9]{64}", archive_sha), "invalid archive hash")
        require(
            not incoming.is_symlink() and incoming.is_dir(), "unsafe staging directory"
        )
        require(
            not target.parent.exists() and not target.parent.is_symlink(),
            "release already exists",
        )
        partial = ROOT / "releases" / f".{release_id}.partial"
        partial.mkdir(mode=0o755)
        pinned = partial / "upload.tar"
        descriptor = os.open(incoming / "backend.tar", os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(descriptor, "rb") as source, pinned.open("xb") as output:
            info = os.fstat(source.fileno())
            require(
                stat.S_ISREG(info.st_mode) and info.st_size <= 256 * 1024 * 1024,
                "invalid uploaded archive",
            )
            shutil.copyfileobj(source, output)
        require(digest(pinned) == archive_sha, "pinned archive hash mismatch")
        unpack_archive(pinned, partial)
        pinned.unlink()
        verify_release(partial / "backend", release_id)
        # Move before building so venv executable shebangs use their permanent path.
        partial.rename(target.parent)
        build_runtime(target, config)
        activate_target(target, previous, config, environment)
        shutil.rmtree(incoming)
        print(f"ACTIVATED={target}\nPREVIOUS={previous}")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Exception as error:
        # Do not expose library errors containing secrets or database URLs.
        print(
            f"ERROR: {error if isinstance(error, RuntimeError) else type(error).__name__}",
            file=sys.stderr,
        )
        sys.exit(1)
