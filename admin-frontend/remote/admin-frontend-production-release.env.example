# Install as /etc/loumai/admin-frontend-production-release.env, root:root 0600.
LOUMAI_H5_ENVIRONMENT=production
LOUMAI_H5_REMOTE_ROOT=/srv/loumai-admin-frontend-production
LOUMAI_H5_STAGING_ROOT=/srv/loumai-admin-frontend-production/incoming
LOUMAI_H5_DEPLOY_USER=loumai-deploy
LOUMAI_H5_PUBLIC_URL=https://admin.example.com
LOUMAI_H5_WEB_USER=www-data
LOUMAI_H5_NGINX_BIN=/usr/sbin/nginx
