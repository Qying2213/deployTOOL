# Replace admin.example.com. Install as an independent site; never overwrite the
# existing API/H5/website configuration. Provision TLS and renewal BEFORE enabling.
server {
    listen 80;
    server_name admin.example.com;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/loumai-admin-production-acme;
        try_files $uri =404;
    }
    location / { return 308 https://admin.example.com$request_uri; }
}

server {
    listen 443 ssl;
    server_name admin.example.com;
    ssl_certificate /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/loumai-admin-frontend-production/frontend-current;
    index index.html;
    access_log off;
    client_max_body_size 32m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /admin-api/api/v1/admin-auth/password-login {
        limit_req zone=loumai_admin_production_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8100/api/v1/admin-auth/password-login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location ^~ /admin-api/api/v1/ {
        proxy_pass http://127.0.0.1:8100/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location = /admin-api/health {
        proxy_pass http://127.0.0.1:8100/health;
        proxy_set_header Host $host;
    }
    location = /admin-api/ready {
        proxy_pass http://127.0.0.1:8100/ready;
        proxy_set_header Host $host;
    }
    location /admin-api/ { return 404; }
    location = /SHA256SUMS { return 404; }
    location ~ /\. { return 404; }
    location ~* \.(env|pem|key|p12|pfx|sql|sqlite|db|bak|map)$ { return 404; }
    # Repeat security headers wherever add_header overrides Nginx inheritance.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /release.json {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri $uri/ /index.html;
    }
}
