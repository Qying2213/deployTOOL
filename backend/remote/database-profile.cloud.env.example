# Install as /etc/loumai/database-profiles/cloud.env; root:root mode 0600.
# Do not commit a real TencentDB username or password.
LOUMAI_DATABASE_PROFILE=cloud
LOUMAI_DATABASE_NAME=YOUR_CLOUD_DATABASE
DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@172.27.0.3:5432/YOUR_CLOUD_DATABASE
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:URL_ENCODED_PASSWORD@172.27.0.3:5432/YOUR_CLOUD_DATABASE
