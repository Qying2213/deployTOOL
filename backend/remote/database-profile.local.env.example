# Install as /etc/loumai/database-profiles/local.env; root:root mode 0600.
LOUMAI_DATABASE_PROFILE=local
LOUMAI_DATABASE_NAME=loumai_test_server
DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/loumai_test_server
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/loumai_test_server
