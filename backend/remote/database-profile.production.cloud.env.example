# Install as /etc/loumai/database-profiles/cloud.env; root:root mode 0600.
# Use three different roles: runtime, migration, and read-only backup. URL-encode their passwords.
# All three URLs must target the same host, port, and database with the same verify-full CA settings.
# The hostname must match TencentDB's certificate; production rejects IP endpoints.
LOUMAI_DATABASE_PROFILE=cloud
LOUMAI_DATABASE_NAME=LOUMAI_PRODUCTION_DATABASE
DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@postgres.production.example.com:5432/LOUMAI_PRODUCTION_DATABASE?sslmode=verify-full&sslrootcert=/etc/loumai/certs/tencentdb-ca.pem
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:URL_ENCODED_PASSWORD@postgres.production.example.com:5432/LOUMAI_PRODUCTION_DATABASE?sslmode=verify-full&sslrootcert=/etc/loumai/certs/tencentdb-ca.pem
BACKUP_DATABASE_URL=postgresql+psycopg://BACKUP_USER:URL_ENCODED_PASSWORD@postgres.production.example.com:5432/LOUMAI_PRODUCTION_DATABASE?sslmode=verify-full&sslrootcert=/etc/loumai/certs/tencentdb-ca.pem
