[Unit]
Description=Run Loumai test push and appointment jobs every 15 seconds

[Timer]
# Use an explicit wall-clock schedule. Relative OnUnitActiveSec may remain in
# active(elapsed) after a deployment stops and restarts both the timer and its
# oneshot service, leaving newly-created notification jobs unprocessed.
OnCalendar=*-*-* *:*:00/15
AccuracySec=5s
Persistent=true
Unit=loumai-app-push-dispatcher.service

[Install]
WantedBy=timers.target
