  assert_installed_release_safety "$RECOVERY_RELEASE"
  assert_release_environment "$RECOVERY_RELEASE"
  verify_source_checksums "$RECOVERY_RELEASE" false
  [[ "$(json_field "$RECOVERY_RELEASE/release.json" release_id)" == "$RECOVERY_RELEASE_ID" ]] \
