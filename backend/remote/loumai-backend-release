  if [[ "$RECOVERY_PREVIOUS_CURRENT" != "NONE" ]]; then
    [[ -d "$RECOVERY_PREVIOUS_CURRENT" && ! -L "$RECOVERY_PREVIOUS_CURRENT" ]] \
      || fail "恢复标记中的上一版本不存在"
    assert_installed_release_safety "$RECOVERY_PREVIOUS_CURRENT"
    assert_release_environment "$RECOVERY_PREVIOUS_CURRENT"
  fi
  if [[ "$ENVIRONMENT" == "production" ]]; then
    [[ "$RECOVERY_DATABASE_PROFILE" == "cloud" ]] \
      || fail "正式服恢复标记必须使用 cloud 数据库"
  fi
}

write_recovery_marker() (
  local release_id="$1" release="$2" previous="$3" initial="$4" phase="$5"
  local start_db_revision="$6" expected_token="$7" temporary current_token=NONE
  local target_revision commit checksums_sha
  valid_release_id "$release_id" || fail "恢复标记 release_id 非法"
  [[ "$release" == "$RELEASES_ROOT/$release_id/backend" ]] \
    || fail "恢复标记版本路径非法"
  [[ -d "$release" && ! -L "$release" ]] || fail "恢复标记版本不存在"
  assert_installed_release_safety "$release"
  verify_source_checksums "$release" false
  [[ "$previous" == "NONE" || "$previous" == "$RELEASES_ROOT/"*/backend ]] \
    || fail "恢复标记上一版本路径非法"
  [[ "$initial" == "true" || "$initial" == "false" ]] || fail "恢复标记 initial 非法"
  [[ "$phase" == "prepared" || "$phase" == "stopped" || "$phase" == "migrating" ]] \
    || fail "恢复标记 phase 非法"
  valid_revision "$start_db_revision" || fail "恢复标记起始 DB revision 非法"
  [[ "$SELECTED_DATABASE_PROFILE" == "local" || "$SELECTED_DATABASE_PROFILE" == "cloud" ]] \
    || fail "恢复标记数据库 profile 非法"
  if recovery_marker_exists; then current_token="$(recovery_marker_token)"; fi
  [[ "$current_token" == "$expected_token" ]] \
    || fail "恢复标记 CAS 已变化，拒绝覆盖"
  target_revision="$(json_field "$release/release.json" artifact_db_head)"
  commit="$(json_field "$release/release.json" commit)"
  checksums_sha="$(sha256sum "$release/SHA256SUMS" | awk '{print $1}')"
  valid_revision "$target_revision" || fail "恢复标记目标 DB revision 非法"
  valid_commit "$commit" || fail "恢复标记 commit 非法"
  valid_sha256 "$checksums_sha" || fail "恢复标记 checksums digest 非法"
  temporary="$(mktemp "$REMOTE_ROOT/.migration-recovery-required.XXXXXX")"
  trap 'rm -f -- "$temporary"' EXIT INT TERM HUP
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  printf '%s\n' \
    'SCHEMA_VERSION=1' \
    "RELEASE_ID=$release_id" \
    "RELEASE_PATH=$release" \
    "PREVIOUS_CURRENT=$previous" \
    "DATABASE_PROFILE=$SELECTED_DATABASE_PROFILE" \
    "INITIAL=$initial" \
    "ENVIRONMENT=$ENVIRONMENT" \
    "DATABASE_NAME=$SELECTED_DATABASE_NAME" \
    "TARGET_REVISION=$target_revision" \
    "COMMIT=$commit" \
    "CHECKSUMS_SHA256=$checksums_sha" > "$temporary"
  printf '%s\n' \
    "PHASE=$phase" \
    "START_DB_REVISION=$start_db_revision" >> "$temporary"
  mv -fT -- "$temporary" "$RECOVERY_FILE"
  trap - EXIT INT TERM HUP
  assert_root_secret_file "$RECOVERY_FILE"
)

recovery_marker_token() {
  assert_root_secret_file "$RECOVERY_FILE"
  sha256sum "$RECOVERY_FILE" | awk '{print $1}'
}

clear_recovery_marker() {
  local expected_token="$1" actual_token
  recovery_marker_exists || fail "恢复标记已意外消失"
  assert_root_secret_file "$RECOVERY_FILE"
  actual_token="$(recovery_marker_token)"
  [[ "$actual_token" == "$expected_token" ]] || fail "恢复标记 CAS 已变化，拒绝清除"
  rm -f -- "$RECOVERY_FILE"
}

assert_no_recovery_marker() {
  recovery_marker_exists \
    && fail "检测到数据库迁移恢复标记；普通发布/回滚已锁定，请使用 backend recover"
  return 0
}

load_app_environment() {
  local parsed_file key value
  parsed_file="$(mktemp "$REMOTE_ROOT/.backend-env.XXXXXX")"
  chmod 0600 "$parsed_file"
  if ! /usr/bin/python3 - "${ENV_FILES[@]}" > "$parsed_file" <<'PY'
import re
import sys


def parse_value(raw: str, filename: str, line_number: int) -> str:
    value = raw.strip()
    if not value:
        return ""
    if value[0] == "'":
        if len(value) < 2 or value[-1] != "'" or "'" in value[1:-1]:
            raise SystemExit(f"invalid single-quoted value: {filename}:{line_number}")
        return value[1:-1]
    if value[0] == '"':
        if len(value) < 2 or value[-1] != '"':
            raise SystemExit(f"invalid double-quoted value: {filename}:{line_number}")
        inner = value[1:-1]
        parsed: list[str] = []
        index = 0
        while index < len(inner):
            character = inner[index]
            if character == "\\" and index + 1 < len(inner) and inner[index + 1] in {'"', "\\"}:
                parsed.append(inner[index + 1])
                index += 2
                continue
            parsed.append(character)
            index += 1
        return "".join(parsed)
    if any(character.isspace() for character in value):
        raise SystemExit(f"unquoted whitespace in environment value: {filename}:{line_number}")
    return value

key_pattern = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
values: dict[str, str] = {}
for filename in sys.argv[1:]:
    with open(filename, encoding="utf-8") as handle:
        for line_number, raw_line in enumerate(handle, 1):
            line = raw_line.rstrip("\r\n")
            stripped = line.strip()
            if not stripped or stripped.startswith(("#", ";")):
                continue
            if "=" not in line:
                raise SystemExit(f"invalid environment line: {filename}:{line_number}")
            key, raw_value = line.split("=", 1)
            key = key.strip()
            if not key_pattern.fullmatch(key):
                raise SystemExit(f"invalid environment key: {filename}:{line_number}")
            value = parse_value(raw_value, filename, line_number)
            if "\x00" in value or "\n" in value or "\r" in value:
                raise SystemExit(f"invalid control byte in environment value: {filename}:{line_number}")
            values[key] = value

for key, value in values.items():
    sys.stdout.buffer.write(key.encode() + b"\0" + value.encode() + b"\0")
PY
  then
    rm -f -- "$parsed_file"
    fail "应用环境文件解析失败"
  fi
  while IFS= read -r -d '' key && IFS= read -r -d '' value; do
    printf -v "$key" '%s' "$value"
    export "$key"
  done < "$parsed_file"
  rm -f -- "$parsed_file"
}

clear_runner_environment() {
  local entry key
  while IFS= read -r -d '' entry; do
    key="${entry%%=*}"
    unset "$key" 2>/dev/null || true
  done < <(/usr/bin/env -0)
  export PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8
  unset BASH_ENV ENV CDPATH TAR_OPTIONS PYTHONPATH PYTHONHOME
}

run_in_release() (
  local release="$1"
  shift
  cd "$release"
  clear_runner_environment
  load_app_environment
  unset MIGRATION_DATABASE_URL BACKUP_DATABASE_URL
  export HOME="$(getent passwd "$SERVICE_USER" | awk -F: '{print $6}')"
  export USER="$SERVICE_USER" LOGNAME="$SERVICE_USER" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
  /usr/sbin/runuser -u "$SERVICE_USER" --preserve-environment -- "$@"
)

run_migration_in_release() (
  local release="$1" migration_url
  shift
  cd "$release"
  clear_runner_environment
  load_app_environment
  migration_url="${MIGRATION_DATABASE_URL:-${DATABASE_URL:-}}"
  [[ -n "$migration_url" ]] || fail "迁移运行器缺少数据库 URL"
  export DATABASE_URL="$migration_url"
  unset MIGRATION_DATABASE_URL BACKUP_DATABASE_URL
  export HOME="$(getent passwd "$MIGRATION_USER" | awk -F: '{print $6}')"
  export USER="$MIGRATION_USER" LOGNAME="$MIGRATION_USER" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
  /usr/sbin/runuser -u "$MIGRATION_USER" --preserve-environment -- "$@"
)

run_backup_in_release() (
  local release="$1" backup_url
  shift
  cd "$release"
  clear_runner_environment
  load_app_environment
  backup_url="${BACKUP_DATABASE_URL:-}"
  if [[ "$ENVIRONMENT" != "production" && -z "$backup_url" ]]; then
    backup_url="${MIGRATION_DATABASE_URL:-${DATABASE_URL:-}}"
  fi
  [[ -n "$backup_url" ]] || fail "备份运行器缺少独立只读数据库 URL"
  clear_runner_environment
  export DATABASE_URL="$backup_url"
  export HOME="$(getent passwd "$BACKUP_USER" | awk -F: '{print $6}')"
  export USER="$BACKUP_USER" LOGNAME="$BACKUP_USER" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
  /usr/sbin/runuser -u "$BACKUP_USER" --preserve-environment -- "$@"
)

