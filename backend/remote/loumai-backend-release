install_runtime() {
  local backend="$1" expected_checksums="$2" build_dir build_source build_home build_group uv_cache runtime_user
  build_dir="${backend%/*}/.runtime-build"
  build_source="$build_dir/source"
  build_home="$(getent passwd "$BUILD_USER" | awk -F: '{print $6}')"
  [[ -n "$build_home" && -d "$build_home" ]] || fail "构建用户 HOME 无效"
  build_group="$(id -gn "$BUILD_USER")"
  uv_cache="$build_home/.cache/uv"
  install -d -m 0700 -o "$BUILD_USER" -g "$build_group" -- "$uv_cache"
  install -d -m 0700 -o "$BUILD_USER" -g "$build_group" -- "$build_dir" "$build_source"
  cp -a --no-preserve=ownership -- "$backend/." "$build_source/"
  chown -hR "$BUILD_USER:$build_group" "$build_source"
  install -d -m 0700 -o "$BUILD_USER" -g "$build_group" -- "$backend/.venv"
  run_as_clean "$BUILD_USER" /usr/bin/env -i --chdir="$build_home" \
    HOME="$build_home" USER="$BUILD_USER" LOGNAME="$BUILD_USER" \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 \
    UV_CACHE_DIR="$uv_cache" UV_LINK_MODE=copy \
    "$UV_BIN" venv --python "$BASE_PYTHON" --seed "$backend/.venv"
  run_as_clean "$BUILD_USER" /usr/bin/env -i --chdir="$build_home" \
    HOME="$build_home" USER="$BUILD_USER" LOGNAME="$BUILD_USER" \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 \
    UV_CACHE_DIR="$uv_cache" UV_LINK_MODE=copy \
    "$UV_BIN" pip install \
      --python "$backend/.venv/bin/python" \
      --constraint "$backend/runtime-constraints.txt" \
      setuptools
  run_as_clean "$BUILD_USER" /usr/bin/env -i --chdir="$build_home" \
    HOME="$build_home" USER="$BUILD_USER" LOGNAME="$BUILD_USER" \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 \
    UV_CACHE_DIR="$uv_cache" UV_LINK_MODE=copy \
    "$UV_BIN" pip install \
      --python "$backend/.venv/bin/python" \
      --no-build-isolation \
      --constraint "$backend/runtime-constraints.txt" \
      "$build_source"
  run_as_clean "$BUILD_USER" /usr/bin/env -i --chdir="$build_home" \
    HOME="$build_home" USER="$BUILD_USER" LOGNAME="$BUILD_USER" \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 \
    UV_CACHE_DIR="$uv_cache" UV_LINK_MODE=copy \
    "$UV_BIN" pip freeze --python "$backend/.venv/bin/python" \
      > "$backend/installed-requirements.txt"
  rm -rf -- "$build_dir"
  chown -hR root:root "$backend/.venv"
  chmod -R a+rX,go-w "$backend/.venv"
  [[ "$(sha256sum "$backend/SHA256SUMS" | awk '{print $1}')" == "$expected_checksums" ]] \
    || fail "依赖安装期间源码清单被修改"
  verify_source_checksums "$backend" false
  assert_installed_release_safety "$backend"
  [[ -x "$backend/.venv/bin/python" ]] || fail "新版本虚拟环境无效"
  for runtime_user in "$SERVICE_USER" "$MIGRATION_USER"; do
    run_as_clean "$runtime_user" /usr/bin/env -i \
      HOME="$(getent passwd "$runtime_user" | awk -F: '{print $6}')" \
      USER="$runtime_user" LOGNAME="$runtime_user" PATH=/usr/sbin:/usr/bin:/sbin:/bin \
      "$backend/.venv/bin/python" -I -S -c \
      'import sys; raise SystemExit(0 if sys.prefix else 1)' \
      || fail "$runtime_user 无法执行新版本虚拟环境"
  done
}

assert_database_target_for_runner() {
  local runner="$1" backend="$2"
  [[ "$runner" == "run_in_release" || "$runner" == "run_migration_in_release" \
    || "$runner" == "run_backup_in_release" ]] \
    || fail "数据库目标检查运行器非法"
  "$runner" "$backend" "$backend/.venv/bin/python" -c '
import os
import sys
from ipaddress import ip_address
from sqlalchemy.engine import make_url
from sqlalchemy import create_engine, text

expected_database, expected_profile, cloud_host, environment, expected_ca = sys.argv[1:6]
targets = {}
application_url = os.getenv("DATABASE_URL")
for name, raw in (
    ("DATABASE_URL", application_url),
    ("MIGRATION_DATABASE_URL", os.getenv("MIGRATION_DATABASE_URL") or application_url),
):
    if not raw:
        raise SystemExit(f"missing {name}")
    url = make_url(raw)
    if not url.drivername.startswith("postgresql"):
        raise SystemExit(f"{name} must use PostgreSQL")
    forbidden_routing_keys = {"host", "hostaddr", "port", "service", "servicefile", "dbname"}
    if forbidden_routing_keys.intersection(url.query):
        raise SystemExit(f"{name} contains forbidden connection-routing query parameters")
    configured_host = url.host
    configured_port = url.port or 5432
    if environment == "production":
        if url.query.get("sslmode") != "verify-full":
            raise SystemExit(f"{name} must use sslmode=verify-full in production")
        if url.query.get("sslrootcert") != expected_ca:
            raise SystemExit(f"{name} must use the configured production CA file")
    if configured_port != 5432:
        raise SystemExit(f"{name} is not using the configured PostgreSQL endpoint port")
    engine = create_engine(raw, pool_pre_ping=True)
    try:
        with engine.connect() as connection:
            database, address, port, tls_active = connection.execute(
                text("""
                    SELECT current_database(), inet_server_addr()::text, inet_server_port(),
                           COALESCE((SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()), false)
                """)
            ).one()
    except Exception:
        raise SystemExit(f"unable to verify {name} target") from None
    finally:
        engine.dispose()
    normalized_address = None if address is None else address.split("/", 1)[0]
    if database != expected_database:
        raise SystemExit(f"{name} does not connect to the configured database")
    if environment == "production" and not tls_active:
        raise SystemExit(f"{name} production connection is not using TLS")
    if expected_profile == "local":
        try:
            configured_is_loopback = ip_address(configured_host).is_loopback
        except (TypeError, ValueError):
            configured_is_loopback = (
                isinstance(configured_host, str) and configured_host.lower() == "localhost"
            )
        if not configured_is_loopback:
            raise SystemExit(f"{name} is not configured for local PostgreSQL")
        if normalized_address is not None and not ip_address(normalized_address).is_loopback:
            raise SystemExit(f"{name} is not the configured local PostgreSQL target")
        if port != configured_port:
            raise SystemExit(f"{name} does not match the configured local PostgreSQL port")
        normalized_target = ("local", configured_host, configured_port)
    elif expected_profile == "cloud":
        if configured_host != cloud_host:
            raise SystemExit(f"{name} is not the configured TencentDB PostgreSQL target")
        # TencentDB may sit behind a proxy/NAT endpoint. In that topology,
        # inet_server_addr()/inet_server_port() identify the selected backend
        # node rather than the configured client endpoint, so they must not be
        # compared with cloud_host:5432. The URL endpoint is checked above and
        # the live connection still has to report the expected database name.
        normalized_target = ("cloud", configured_host, configured_port)
    else:
        raise SystemExit("invalid expected database profile")
    targets[name] = (normalized_target, database)
if targets["DATABASE_URL"] != targets["MIGRATION_DATABASE_URL"]:
    raise SystemExit("application and migration database targets differ")
print(repr(targets["DATABASE_URL"]))
' "$SELECTED_DATABASE_NAME" "$SELECTED_DATABASE_PROFILE" "$CLOUD_DATABASE_HOST" \
    "$ENVIRONMENT" "$DATABASE_CA_FILE"
}

