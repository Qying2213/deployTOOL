  [[ "$(stat -c '%u' "$build_home")" == "$build_uid" ]] || fail "构建用户 HOME 所有权错误"
  [[ -z "$(find "$build_home" -maxdepth 0 -perm /022 -print -quit)" ]] \
    || fail "构建用户 HOME 不能被组或其他用户写入"
  [[ "$build_shell" == "/usr/sbin/nologin" || "$build_shell" == "/sbin/nologin" ]] \
    || fail "构建用户必须禁止交互登录"
  validate_backup_root
	[[ "$(backup_root_available_bytes)" -ge "$BACKUP_MIN_FREE_BYTES" ]] \
		|| fail "数据库备份目录剩余空间低于发布门禁：$BACKUP_MIN_FREE_BYTES bytes"
	if [[ "$ENVIRONMENT" == "production" ]]; then
		assert_root_owned_directory "${DATABASE_CA_FILE%/*}"
		assert_root_owned_file "$DATABASE_CA_FILE"
		getent group "$DATABASE_CA_GROUP" >/dev/null || fail "数据库 CA 专用组不存在：$DATABASE_CA_GROUP"
		[[ "$(stat -c '%G' "${DATABASE_CA_FILE%/*}")" == "$DATABASE_CA_GROUP" \
		  && "$(stat -c '%a' "${DATABASE_CA_FILE%/*}")" == "750" ]] \
			|| fail "数据库 CA 目录必须是 root:$DATABASE_CA_GROUP 0750"
		[[ "$(stat -c '%G' "$DATABASE_CA_FILE")" == "$DATABASE_CA_GROUP" \
		  && "$(stat -c '%a' "$DATABASE_CA_FILE")" == "640" ]] \
			|| fail "数据库 CA 文件必须是 root:$DATABASE_CA_GROUP 0640"
		for user in "$SERVICE_USER" "$VIDEO_SERVICE_USER" "$IM_SERVICE_USER" \
		  "$JOB_SERVICE_USER" "$MIGRATION_USER" "$BACKUP_USER"; do
			id -nG "$user" | tr ' ' '\n' | grep -Fxq "$DATABASE_CA_GROUP" \
				|| fail "$user 未加入数据库 CA 专用组 $DATABASE_CA_GROUP"
			run_as_clean "$user" /usr/bin/head -c 1 "$DATABASE_CA_FILE" >/dev/null \
