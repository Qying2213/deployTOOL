  [[ "${API_DOCS_ENABLED:-}" == "false" ]] || fail "正式服必须关闭 API_DOCS_ENABLED"
  [[ "${ALLOW_MOCK_WECHAT:-}" == "false" ]] || fail "正式服必须关闭 ALLOW_MOCK_WECHAT"
  [[ "${REGISTRATION_SMS_VERIFICATION_ENABLED:-}" == "true" ]] \
    || fail "正式服必须开启注册短信校验"
  [[ "${GEO_WEBVIEW_COOKIE_SECURE:-}" == "true" ]] \
    || fail "正式服 GEO WebView Cookie 必须启用 Secure"
  [[ "${SMS_PROVIDER:-}" != "mock" && -n "${SMS_PROVIDER:-}" ]] \
    || fail "正式服短信服务不能使用 mock"
  [[ "${FILE_STORAGE_PROVIDER:-}" == "tencent_cos" ]] \
    || fail "正式服文件存储必须使用 tencent_cos"
  [[ "${VIDEO_TRANSCODE_ENABLED:-}" == "true" ]] \
    || fail "正式服必须启用独立视频转码 Worker"
  [[ -n "${TENCENT_COS_REGION:-}" && -n "${TENCENT_COS_BUCKET:-}" \
    && -n "${TENCENT_COS_SECRET_ID:-}" && -n "${TENCENT_COS_SECRET_KEY:-}" ]] \
    || fail "正式服腾讯云 COS 配置不完整"
  [[ "${BACKEND_CORS_ORIGIN_REGEX:-}" == "" ]] \
    || fail "正式服禁止使用 BACKEND_CORS_ORIGIN_REGEX"
  /usr/bin/python3 - "$PUBLIC_HEALTH_URL" "$LOCAL_REDIS_APPROVED" <<'PY'
import json
import os
import sys
from ipaddress import ip_address
from urllib.parse import urlsplit


def unsafe_host(host: str) -> bool:
    normalized = host.strip().lower().rstrip(".")
    if not normalized or normalized in {"localhost", "*"}:
        return True
    try:
        return not ip_address(normalized).is_global
    except ValueError:
        return normalized.endswith((".local", ".localhost", ".internal"))


def unsafe_private_redis_host(host: str) -> bool:
    normalized = host.strip().lower().rstrip(".")
    if not normalized or normalized in {"localhost", "*"}:
        return True
    try:
        address = ip_address(normalized)
    except ValueError:
        # Tencent Redis exposes an internal IPv4 address in the instance details.
        # Requiring a literal address keeps the production check deterministic and
        # prevents a public DNS record from silently turning Redis into a public
        # dependency.
        return True
    return (
        not address.is_private
        or address.is_loopback
        or address.is_unspecified
        or address.is_link_local
        or address.is_multicast
    )


def environment_string_list(name: str) -> list[str]:
    raw_value = os.getenv(name, "").strip()
    if not raw_value:
        return []
    if raw_value.startswith("["):
        try:
            values = json.loads(raw_value)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"production {name} must be a valid JSON string array") from exc
        if not isinstance(values, list) or any(not isinstance(value, str) for value in values):
            raise SystemExit(f"production {name} must be a JSON string array")
        return [value.strip() for value in values if value.strip()]
    return [value.strip() for value in raw_value.split(",") if value.strip()]


public_host = urlsplit(sys.argv[1]).hostname or ""
allowed_hosts = environment_string_list("BACKEND_ALLOWED_HOSTS")
if not allowed_hosts or public_host not in allowed_hosts or any(unsafe_host(host) for host in allowed_hosts):
    raise SystemExit("production BACKEND_ALLOWED_HOSTS is unsafe")

origins = environment_string_list("BACKEND_CORS_ORIGINS")
if not origins:
    raise SystemExit("production BACKEND_CORS_ORIGINS is empty")
for origin in origins:
    parsed = urlsplit(origin)
    if parsed.scheme != "https" or not parsed.hostname or unsafe_host(parsed.hostname):
        raise SystemExit("production BACKEND_CORS_ORIGINS must contain public HTTPS origins only")
    if parsed.path not in {"", "/"} or parsed.query or parsed.fragment or parsed.username or parsed.password:
        raise SystemExit("production BACKEND_CORS_ORIGINS contains an invalid origin")

redis = urlsplit(os.getenv("REDIS_URL", ""))
local_redis_approved = sys.argv[2] == "true"
redis_host = (redis.hostname or "").strip().lower()
if (
    redis.scheme != "rediss"
    or not redis_host
    or (
        redis_host == "127.0.0.1"
        and not local_redis_approved
    )
    or (
        redis_host != "127.0.0.1"
        and unsafe_private_redis_host(redis_host)
    )
):
    raise SystemExit(
        "production REDIS_URL must use a private VPC rediss endpoint, "
        "or explicitly approved loopback TLS Redis"
    )

application = urlsplit(os.environ["DATABASE_URL"])
migration = urlsplit(os.environ.get("MIGRATION_DATABASE_URL") or os.environ["DATABASE_URL"])
backup = urlsplit(os.environ.get("BACKUP_DATABASE_URL", ""))
users = (application.username, migration.username, backup.username)
if not all(users) or len(set(users)) != 3:
    raise SystemExit("production runtime, migration and backup database users must all be different")
PY
)

