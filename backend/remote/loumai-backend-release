    "$SELECTED_DATABASE_NAME" "$CLOUD_DATABASE_HOST" "$ENVIRONMENT" "$DATABASE_CA_FILE" <<'PY'
import ipaddress
import sys
from urllib.parse import parse_qs, urlsplit

pid, expected_profile, expected_database, cloud_host, target_environment, expected_ca = sys.argv[1:]
with open(f"/proc/{pid}/environ", "rb") as handle:
    environment = {}
    for entry in handle.read().split(b"\0"):
        if b"=" not in entry:
            continue
        key, value = entry.split(b"=", 1)
        environment[key.decode("utf-8", "strict")] = value.decode("utf-8", "strict")

if target_environment == "production" and (
    "MIGRATION_DATABASE_URL" in environment or "BACKUP_DATABASE_URL" in environment
):
