    || fail "正式服本地 Redis 审批值只能是 true 或 false"
  load_app_environment
  [[ "${APP_ENVIRONMENT:-}" == "production" ]] || fail "正式服 APP_ENVIRONMENT 必须是 production"
  [[ "${ALLOW_INSECURE_TEST_SETTINGS:-}" == "false" ]] \
