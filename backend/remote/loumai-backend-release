stop_writers() {
  stop_all_units || fail "未能确认所有数据库 writer 已停止"
}

start_services() {
  local index
  for ((index=${#SERVICES[@]} - 1; index>=0; index--)); do
    systemctl start "${SERVICES[$index]}" || return 1
  done
  for ((index=${#AUXILIARY_DATABASE_SERVICES[@]} - 1; index>=0; index--)); do
    systemctl start "${AUXILIARY_DATABASE_SERVICES[$index]}" || return 1
  done
}

start_timers() {
  local unit
  for unit in "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    systemctl start "$unit" || return 1
    systemctl is-active --quiet "$unit" || return 1
  done
}

assert_initial_units_stopped() {
  local unit
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" \
    "${ONESHOT_SERVICES[@]}" "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    if systemctl is-active --quiet "$unit"; then
      fail "首次发布要求所有 writer 预先停止：$unit"
    fi
  done
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    [[ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" == "disabled" ]] \
      || fail "首次发布要求所有持久 writer 预先 disabled：$unit"
  done
}

enable_persistent_units() {
  local unit
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    systemctl enable "$unit"
  done
}

disable_persistent_units() {
  local unit state failed=0
  for unit in "${TIMERS[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" "${SERVICES[@]}"; do
    [[ -n "$unit" ]] || continue
    systemctl disable "$unit" || failed=1
    state="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
    [[ "$state" == "disabled" ]] || failed=1
  done
  return "$failed"
}

verify_persistent_units() {
  local unit state
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    state="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
    [[ "$state" == "enabled" ]] \
      || fail "正式服持久服务必须精确设置为 enabled：$unit（当前 $state）"
  done
  for unit in "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    systemctl is-active --quiet "$unit" || fail "正式服定时器未运行：$unit"
  done
}

stop_all_units() {
  local unit failed=0
  for unit in "${TIMERS[@]}" "${ONESHOT_SERVICES[@]}" \
    "${AUXILIARY_DATABASE_SERVICES[@]}" "${SERVICES[@]}"; do
    [[ -n "$unit" ]] || continue
    systemctl stop "$unit" || failed=1
  done
  verify_all_units_stopped || failed=1
  return "$failed"
}

verify_all_units_stopped() {
  local unit state main_pid failed=0
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" \
    "${ONESHOT_SERVICES[@]}" "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    state="$(systemctl is-active "$unit" 2>/dev/null || true)"
    main_pid="$(systemctl show "$unit" -p MainPID --value 2>/dev/null || true)"
    if [[ "$state" != "inactive" && "$state" != "failed" ]]; then
      printf 'CRITICAL: writer 未停止：%s（state=%s）\n' "$unit" "${state:-unknown}" >&2
      failed=1
    fi
    # Timer units do not expose MainPID on current systemd versions. An empty
    # value is safe only after ActiveState above has been proven inactive/failed.
    if [[ -n "$main_pid" && "$main_pid" != "0" ]]; then
      printf 'CRITICAL: writer 仍有 MainPID：%s（MainPID=%s）\n' "$unit" "${main_pid:-unknown}" >&2
      failed=1
    fi
  done
  return "$failed"
}

verify_persistent_units_disabled() {
  local unit state failed=0
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    state="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
    if [[ "$state" != "disabled" ]]; then
      printf 'CRITICAL: writer 未持久禁用：%s（enabled=%s）\n' "$unit" "${state:-unknown}" >&2
      failed=1
    fi
  done
  return "$failed"
}

assert_recovery_units_fail_closed() {
  verify_all_units_stopped || fail "恢复模式要求所有 writer 精确停止"
  verify_persistent_units_disabled || fail "恢复模式要求所有持久 writer 精确 disabled"
}

ensure_fail_closed_state() {
  local failed=0
  stop_all_units || failed=1
  disable_persistent_units || failed=1
  verify_all_units_stopped || failed=1
  verify_persistent_units_disabled || failed=1
  return "$failed"
}

