#!/bin/bash

set -euo pipefail
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export GIT_PAGER=cat PAGER=cat SYSTEMD_PAGER=cat SYSTEMD_COLORS=0
unset BASH_ENV ENV CDPATH TAR_OPTIONS PYTHONPATH PYTHONHOME
umask 022

readonly HELPER_VERSION="6"
readonly CONFIG_FILE="/etc/loumai/backend-release.env"

# These two installation checks must work before the server configuration exists.
case "${1:-}" in
  version)
    [[ "$#" -eq 1 ]] || { printf 'ERROR: version 参数数量错误\n' >&2; exit 1; }
    printf '%s\n' "$HELPER_VERSION"
    exit 0
    ;;
  fingerprint)
    [[ "$#" -eq 1 ]] || { printf 'ERROR: fingerprint 参数数量错误\n' >&2; exit 1; }
    command -v sha256sum >/dev/null 2>&1 \
      || { printf 'ERROR: 服务器缺少命令：sha256sum\n' >&2; exit 1; }
    sha256sum "$0" | awk '{print $1}'
    exit 0
    ;;
esac

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "服务器缺少命令：$1"
}

run_as_clean() {
  local user="$1"
  shift
  /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 \
    /usr/sbin/runuser -u "$user" -- "$@"
}

valid_absolute_path() {
  [[ "$1" == /* && "$1" != "/" && "$1" != *".."* && "$1" =~ ^/[A-Za-z0-9._/-]+$ ]]
}

valid_release_id() {
  [[ "$1" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,12}$ ]]
}

valid_commit() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

valid_revision() {
  [[ "$1" =~ ^[A-Za-z0-9_]+$ ]]
}

valid_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}

assert_root_owned_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || fail "文件不存在或是软链接：$path"
  [[ "$(stat -c '%u' "$path")" == "0" ]] || fail "文件必须归 root 所有：$path"
  [[ -z "$(find "$path" -maxdepth 0 -perm /022 -print -quit)" ]] \
    || fail "文件不能被组或其他用户写入：$path"
}

assert_root_secret_file() {
  local path="$1"
  assert_root_owned_file "$path"
  [[ "$(stat -c '%g' "$path")" == "0" && "$(stat -c '%a' "$path")" == "600" ]] \
    || fail "秘密文件必须是 root:root 0600：$path"
  [[ "$(stat -c '%h' "$path")" == "1" ]] || fail "秘密文件不能包含硬链接：$path"
}

assert_root_owned_directory() {
  local path="$1"
  [[ -d "$path" && ! -L "$path" ]] || fail "目录不存在或是软链接：$path"
  [[ "$(readlink -f "$path")" == "$path" ]] || fail "目录路径包含软链接：$path"
  [[ "$(stat -c '%u' "$path")" == "0" ]] || fail "目录必须归 root 所有：$path"
  [[ -z "$(find "$path" -maxdepth 0 -perm /022 -print -quit)" ]] \
    || fail "目录不能被组或其他用户写入：$path"
}

[[ -r "$CONFIG_FILE" ]] || fail "找不到服务器配置：$CONFIG_FILE"
assert_root_owned_directory "${CONFIG_FILE%/*}"
assert_root_owned_file "$CONFIG_FILE"
# shellcheck source=/dev/null
source "$CONFIG_FILE"
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export GIT_PAGER=cat PAGER=cat SYSTEMD_PAGER=cat SYSTEMD_COLORS=0
unset BASH_ENV ENV CDPATH TAR_OPTIONS PYTHONPATH PYTHONHOME

: "${LOUMAI_BACKEND_REMOTE_ROOT:?缺少 LOUMAI_BACKEND_REMOTE_ROOT}"
: "${LOUMAI_BACKEND_ENVIRONMENT:?缺少 LOUMAI_BACKEND_ENVIRONMENT}"
: "${LOUMAI_BACKEND_STAGING_ROOT:?缺少 LOUMAI_BACKEND_STAGING_ROOT}"
: "${LOUMAI_BACKEND_DEPLOY_USER:?缺少 LOUMAI_BACKEND_DEPLOY_USER}"
: "${LOUMAI_BACKEND_SERVICE_USER:?缺少 LOUMAI_BACKEND_SERVICE_USER}"
: "${LOUMAI_BACKEND_BUILD_USER:?缺少 LOUMAI_BACKEND_BUILD_USER}"
: "${LOUMAI_BACKEND_CURRENT_LINK:?缺少 LOUMAI_BACKEND_CURRENT_LINK}"
: "${LOUMAI_BACKEND_ENV_FILES:?缺少 LOUMAI_BACKEND_ENV_FILES}"
: "${LOUMAI_BACKEND_UV_BIN:?缺少 LOUMAI_BACKEND_UV_BIN}"
: "${LOUMAI_BACKEND_BASE_PYTHON:?缺少 LOUMAI_BACKEND_BASE_PYTHON}"
: "${LOUMAI_BACKEND_RUNTIME_ROOT:?缺少 LOUMAI_BACKEND_RUNTIME_ROOT}"
: "${LOUMAI_BACKEND_DATABASE_NAME:?缺少 LOUMAI_BACKEND_DATABASE_NAME}"
: "${LOUMAI_BACKEND_BACKUP_ROOT:?缺少 LOUMAI_BACKEND_BACKUP_ROOT}"
: "${LOUMAI_BACKEND_SERVICES:?缺少 LOUMAI_BACKEND_SERVICES}"
: "${LOUMAI_BACKEND_LOCAL_HEALTH_URL:?缺少 LOUMAI_BACKEND_LOCAL_HEALTH_URL}"
: "${LOUMAI_BACKEND_PUBLIC_HEALTH_URL:?缺少 LOUMAI_BACKEND_PUBLIC_HEALTH_URL}"

readonly REMOTE_ROOT="$LOUMAI_BACKEND_REMOTE_ROOT"
readonly ENVIRONMENT="$LOUMAI_BACKEND_ENVIRONMENT"
readonly STAGING_ROOT="$LOUMAI_BACKEND_STAGING_ROOT"
readonly DEPLOY_USER="$LOUMAI_BACKEND_DEPLOY_USER"
readonly SERVICE_USER="$LOUMAI_BACKEND_SERVICE_USER"
readonly VIDEO_SERVICE_USER="${LOUMAI_BACKEND_VIDEO_SERVICE_USER:-$SERVICE_USER}"
readonly IM_SERVICE_USER="${LOUMAI_BACKEND_IM_SERVICE_USER:-$SERVICE_USER}"
readonly JOB_SERVICE_USER="${LOUMAI_BACKEND_JOB_SERVICE_USER:-$SERVICE_USER}"
readonly MIGRATION_USER="${LOUMAI_BACKEND_MIGRATION_USER:-$SERVICE_USER}"
readonly BUILD_USER="$LOUMAI_BACKEND_BUILD_USER"
readonly CURRENT_LINK="$LOUMAI_BACKEND_CURRENT_LINK"
readonly UV_BIN="$LOUMAI_BACKEND_UV_BIN"
readonly BASE_PYTHON="$LOUMAI_BACKEND_BASE_PYTHON"
readonly RUNTIME_ROOT="$LOUMAI_BACKEND_RUNTIME_ROOT"
readonly DATABASE_NAME="$LOUMAI_BACKEND_DATABASE_NAME"
readonly DATABASE_PROFILE_DIR="${LOUMAI_BACKEND_DATABASE_PROFILE_DIR:-/etc/loumai/database-profiles}"
readonly ACTIVE_DATABASE_ENV="${LOUMAI_BACKEND_ACTIVE_DATABASE_ENV:-/etc/loumai/database-active.env}"
readonly CLOUD_DATABASE_HOST="${LOUMAI_BACKEND_CLOUD_DATABASE_HOST:-172.27.0.3}"
readonly DATABASE_CA_FILE="${LOUMAI_BACKEND_DATABASE_CA_FILE:-}"
readonly DATABASE_CA_GROUP="${LOUMAI_BACKEND_DATABASE_CA_GROUP:-}"
readonly BACKUP_ROOT="$LOUMAI_BACKEND_BACKUP_ROOT"
readonly BACKUP_USER="${LOUMAI_BACKEND_BACKUP_USER:-postgres}"
readonly BACKUP_MIN_FREE_BYTES="${LOUMAI_BACKEND_BACKUP_MIN_FREE_BYTES:-10737418240}"
readonly LOCAL_HEALTH_URL="$LOUMAI_BACKEND_LOCAL_HEALTH_URL"
readonly PUBLIC_HEALTH_URL="$LOUMAI_BACKEND_PUBLIC_HEALTH_URL"
readonly VIDEO_SERVICE="${LOUMAI_BACKEND_VIDEO_SERVICE:-loumai-video-worker.service}"
readonly FFMPEG_BIN="${LOUMAI_BACKEND_FFMPEG_BIN:-$RUNTIME_ROOT/ffmpeg/bin/ffmpeg}"
readonly FFPROBE_BIN="${LOUMAI_BACKEND_FFPROBE_BIN:-$RUNTIME_ROOT/ffmpeg/bin/ffprobe}"
readonly VIDEO_TEMP_ROOT="${LOUMAI_BACKEND_VIDEO_TEMP_ROOT:-/var/lib/loumai-video/tmp}"
readonly DIRECT_UPLOAD_APPROVED="${LOUMAI_BACKEND_PROPERTY_VIDEO_DIRECT_UPLOAD_APPROVED:-false}"
readonly MONOLITHIC_SECRET_SCOPE_APPROVED="${LOUMAI_BACKEND_MONOLITHIC_SETTINGS_SECRET_SCOPE_APPROVED:-false}"
readonly LOCAL_REDIS_APPROVED="${LOUMAI_BACKEND_LOCAL_REDIS_APPROVED:-false}"
readonly OFFSITE_BACKUP_EVIDENCE_FILE="${LOUMAI_BACKEND_OFFSITE_BACKUP_EVIDENCE_FILE:-}"
readonly RELEASES_ROOT="$REMOTE_ROOT/backend-releases"
readonly LOCK_FILE="$REMOTE_ROOT/.backend-release.lock"
readonly RECOVERY_FILE="$REMOTE_ROOT/.migration-recovery-required"

read -r -a BASE_ENV_FILES <<< "$LOUMAI_BACKEND_ENV_FILES"
ENV_FILES=("${BASE_ENV_FILES[@]}")
SELECTED_DATABASE_PROFILE="local"
SELECTED_DATABASE_NAME="$DATABASE_NAME"
SELECTED_DATABASE_ENV=""
read -r -a SERVICES <<< "$LOUMAI_BACKEND_SERVICES"
read -r -a AUXILIARY_DATABASE_SERVICES <<< "${LOUMAI_BACKEND_AUXILIARY_DATABASE_SERVICES:-}"
read -r -a TIMERS <<< "${LOUMAI_BACKEND_TIMERS:-}"
read -r -a ONESHOT_SERVICES <<< "${LOUMAI_BACKEND_ONESHOT_SERVICES:-}"

[[ "$ENVIRONMENT" == "test" || "$ENVIRONMENT" == "production" ]] \
  || fail "LOUMAI_BACKEND_ENVIRONMENT 只能是 test 或 production"
if [[ "$ENVIRONMENT" == "production" ]]; then
  : "${LOUMAI_BACKEND_CLOUD_DATABASE_HOST:?正式服必须显式配置云数据库 DNS endpoint}"
  : "${LOUMAI_BACKEND_DATABASE_CA_FILE:?正式服必须配置数据库 CA 文件}"
  : "${LOUMAI_BACKEND_DATABASE_CA_GROUP:?正式服必须配置数据库 CA 专用组}"
  : "${LOUMAI_BACKEND_OFFSITE_BACKUP_EVIDENCE_FILE:?正式服必须配置异地备份与恢复演练证据文件}"
fi

for path in "$REMOTE_ROOT" "$STAGING_ROOT" "$CURRENT_LINK" "$BACKUP_ROOT" "$RUNTIME_ROOT" \
  "$FFMPEG_BIN" "$FFPROBE_BIN" "$VIDEO_TEMP_ROOT" "$DATABASE_PROFILE_DIR" "$ACTIVE_DATABASE_ENV"; do
  valid_absolute_path "$path" || fail "配置包含不安全绝对路径：$path"
done
[[ "$LOCAL_HEALTH_URL" =~ ^http://127\.0\.0\.1:[0-9]+/[A-Za-z0-9._/-]+$ ]] \
  || fail "LOCAL_HEALTH_URL 必须是 127.0.0.1 HTTP 地址"
[[ "$PUBLIC_HEALTH_URL" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9._/-]+$ ]] \
  || fail "PUBLIC_HEALTH_URL 必须是 HTTPS 地址"
PUBLIC_HEALTH_AUTHORITY="${PUBLIC_HEALTH_URL#https://}"
PUBLIC_HEALTH_AUTHORITY="${PUBLIC_HEALTH_AUTHORITY%%/*}"
readonly PUBLIC_HEALTH_AUTHORITY
[[ "$DATABASE_NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail "数据库名格式非法"
[[ "$CLOUD_DATABASE_HOST" =~ ^[A-Za-z0-9.-]+$ ]] || fail "云数据库 Host 格式非法"
[[ "$BACKUP_MIN_FREE_BYTES" =~ ^[1-9][0-9]*$ ]] || fail "备份最小剩余空间配置非法"
[[ "$DIRECT_UPLOAD_APPROVED" == "true" || "$DIRECT_UPLOAD_APPROVED" == "false" ]] \
  || fail "PROPERTY_VIDEO 直传发布确认只能是 true 或 false"
[[ "$MONOLITHIC_SECRET_SCOPE_APPROVED" == "true" || "$MONOLITHIC_SECRET_SCOPE_APPROVED" == "false" ]] \
  || fail "统一 Settings 密钥范围确认只能是 true 或 false"
if [[ -n "$DATABASE_CA_FILE" ]]; then
  valid_absolute_path "$DATABASE_CA_FILE" || fail "数据库 CA 文件路径非法"
fi
if [[ -n "$DATABASE_CA_GROUP" ]]; then
  [[ "$DATABASE_CA_GROUP" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "数据库 CA 组名格式非法"
fi
if [[ -n "$OFFSITE_BACKUP_EVIDENCE_FILE" ]]; then
  valid_absolute_path "$OFFSITE_BACKUP_EVIDENCE_FILE" || fail "异地备份证据文件路径非法"
fi

for command_name in awk basename cat chmod chown cp curl df env find flock getent grep id install ln mktemp mv pg_dump pg_restore readlink rm runuser seq sha256sum sleep sort stat systemctl tar tr wc; do
  require_command "$command_name"
done
[[ -x /usr/bin/python3 ]] || fail "缺少 /usr/bin/python3"
[[ -x /usr/sbin/runuser ]] || fail "缺少 /usr/sbin/runuser"

validate_units() {
  local unit primary auxiliary
  local -A seen=()
	[[ "${#SERVICES[@]}" -gt 0 ]] || fail "至少配置一个后端 service"
  [[ " ${ONESHOT_SERVICES[*]} " == *" loumai-file-storage-cleanup.service "* ]] \
    || fail "所有环境都必须纳管 loumai-file-storage-cleanup.service"
  [[ " ${TIMERS[*]} " == *" loumai-file-storage-cleanup.timer "* ]] \
    || fail "所有环境都必须纳管 loumai-file-storage-cleanup.timer"
  if [[ "$ENVIRONMENT" == "production" ]]; then
    # An installed/active production admin writer cannot be silently omitted.
    if [[ -L /srv/loumai-company-management-production/current ]] \
      || systemctl is-active --quiet loumai-company-management.service \
      || systemctl is-enabled --quiet loumai-company-management.service; then
      [[ " ${AUXILIARY_DATABASE_SERVICES[*]} " == *" loumai-company-management.service "* ]] \
        || fail "正式管理后台 writer 未纳入数据库停写栅栏"
    fi
    [[ " ${ONESHOT_SERVICES[*]} " == *" loumai-app-push-dispatcher.service "* ]] \
      || fail "正式服必须纳管 loumai-app-push-dispatcher.service"
    [[ " ${ONESHOT_SERVICES[*]} " == *" loumai-rent-billing.service "* ]] \
      || fail "正式服必须纳管 loumai-rent-billing.service"
    [[ " ${TIMERS[*]} " == *" loumai-app-push-dispatcher.timer "* ]] \
      || fail "正式服必须纳管 loumai-app-push-dispatcher.timer"
    [[ " ${TIMERS[*]} " == *" loumai-rent-billing.timer "* ]] \
      || fail "正式服必须纳管 loumai-rent-billing.timer"
  fi
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" "${ONESHOT_SERVICES[@]}"; do
		[[ -n "$unit" ]] || continue
		[[ "$unit" =~ ^[A-Za-z0-9_.@-]+\.service$ ]] || fail "systemd service 格式非法：$unit"
		[[ -z "${seen[$unit]:-}" ]] || fail "systemd unit 重复配置：$unit"
		seen[$unit]=1
		systemctl cat "$unit" >/dev/null || fail "systemd unit 不存在：$unit"
	done
	for unit in "${TIMERS[@]}"; do
		[[ -n "$unit" ]] || continue
		[[ "$unit" =~ ^[A-Za-z0-9_.@-]+\.timer$ ]] || fail "systemd timer 格式非法：$unit"
		[[ -z "${seen[$unit]:-}" ]] || fail "systemd unit 重复配置：$unit"
		seen[$unit]=1
		systemctl cat "$unit" >/dev/null || fail "systemd unit 不存在：$unit"
	done
  for primary in "${SERVICES[@]}"; do
    for auxiliary in "${AUXILIARY_DATABASE_SERVICES[@]}"; do
      [[ "$primary" != "$auxiliary" ]] || fail "service 不能同时属于业务发布和独立数据库服务：$primary"
    done
  done
}

validate_service_user_contract() {
  local unit expected_user actual_user
  [[ "$ENVIRONMENT" == "production" ]] || return 0
  for unit in "${SERVICES[@]}"; do
    case "$unit" in
      loumai-api.service)
        expected_user="$SERVICE_USER"
        ;;
      loumai-im-worker.service)
        expected_user="$IM_SERVICE_USER"
        ;;
      "$VIDEO_SERVICE")
        expected_user="$VIDEO_SERVICE_USER"
        ;;
      *)
        fail "正式服包含未识别的长驻服务：$unit"
        ;;
    esac
    actual_user="$(systemctl show "$unit" -p User --value)"
    [[ "$actual_user" == "$expected_user" ]] \
      || fail "$unit 运行用户必须是 $expected_user"
  done
  for unit in loumai-api.service loumai-im-worker.service "$VIDEO_SERVICE"; do
    [[ " ${SERVICES[*]} " == *" $unit "* ]] || fail "正式服缺少长驻服务：$unit"
  done
}

validate_database_ca_service_contract() {
  local unit supplementary_groups
  [[ "$ENVIRONMENT" == "production" ]] || return 0
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" "${ONESHOT_SERVICES[@]}"; do
    [[ -n "$unit" ]] || continue
    supplementary_groups="$(systemctl show "$unit" -p SupplementaryGroups --value)"
    tr ' ' '\n' <<<"$supplementary_groups" | grep -Fxq "$DATABASE_CA_GROUP" \
      || fail "$unit 必须显式声明 SupplementaryGroups=$DATABASE_CA_GROUP"
  done
}

validate_environment_files() {
  local path
  [[ "${#ENV_FILES[@]}" -gt 0 ]] || fail "未配置应用环境文件"
  for path in "${ENV_FILES[@]}"; do
    valid_absolute_path "$path" || fail "环境文件路径非法：$path"
    assert_root_owned_directory "${path%/*}"
    if [[ "$ENVIRONMENT" == "production" ]]; then
      assert_root_secret_file "$path"
    else
      assert_root_owned_file "$path"
    fi
  done
}

valid_database_profile() {
  [[ "$1" == "local" || "$1" == "cloud" || "$1" == "active" ]]
}

database_profile_file() {
  local profile="$1"
  valid_database_profile "$profile" || fail "数据库 profile 非法：$profile"
  [[ "$profile" != "active" ]] || fail "active 不是 profile 文件名"
  printf '%s/%s.env\n' "$DATABASE_PROFILE_DIR" "$profile"
}

database_profile_marker() {
  local path="$1"
  /usr/bin/python3 - "$path" <<'PY'
import re
import sys

path = sys.argv[1]
marker = ""
with open(path, encoding="utf-8") as handle:
    for raw in handle:
        line = raw.strip()
        if not line or line.startswith(("#", ";")) or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() != "LOUMAI_DATABASE_PROFILE":
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        marker = value
print(marker)
PY
}

active_database_profile() {
  local marker
  if [[ ! -e "$ACTIVE_DATABASE_ENV" && ! -L "$ACTIVE_DATABASE_ENV" ]]; then
    printf 'local\n'
    return
  fi
  if [[ "$ENVIRONMENT" == "production" ]]; then
    assert_root_secret_file "$ACTIVE_DATABASE_ENV"
  else
    assert_root_owned_file "$ACTIVE_DATABASE_ENV"
  fi
  validate_active_database_env
  marker="$(database_profile_marker "$ACTIVE_DATABASE_ENV")"
  [[ "$marker" == "local" || "$marker" == "cloud" ]] \
    || fail "活动数据库 profile 标记缺失或非法"
  printf '%s\n' "$marker"
}

validate_active_database_env() {
  [[ "$ENVIRONMENT" == "production" ]] || return 0
  /usr/bin/python3 - "$ACTIVE_DATABASE_ENV" <<'PY'
import re
import sys

path = sys.argv[1]
allowed = {"LOUMAI_DATABASE_PROFILE", "LOUMAI_DATABASE_NAME", "DATABASE_URL"}
seen = set()
with open(path, encoding="utf-8") as handle:
    for raw in handle:
        line = raw.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if "=" not in line:
            raise SystemExit("production active database env contains an invalid line")
        key = line.split("=", 1)[0].strip()
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            raise SystemExit("production active database env contains an invalid key")
        if key not in allowed:
            raise SystemExit("production active database env contains a forbidden key: " + key)
        if key in seen:
            raise SystemExit("production active database env contains a duplicate key: " + key)
        seen.add(key)
if seen != allowed:
    raise SystemExit("production active database env must contain only runtime database fields")
PY
}

validate_base_database_isolation() {
  [[ "$ENVIRONMENT" == "production" ]] || return 0
  /usr/bin/python3 - "${BASE_ENV_FILES[@]}" <<'PY'
import re
import sys

locations = {}
for path in sys.argv[1:]:
    with open(path, encoding="utf-8") as handle:
        for raw in handle:
            line = raw.strip()
            if not line or line.startswith(("#", ";")) or "=" not in line:
                continue
            key = line.split("=", 1)[0].strip()
            if key in {"DATABASE_URL", "MIGRATION_DATABASE_URL", "BACKUP_DATABASE_URL", "LOUMAI_DATABASE_PROFILE", "LOUMAI_DATABASE_NAME"}:
                raise SystemExit(
                    "production database credentials must exist only in the root-owned database profile: "
                    + key
                )
            if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
                raise SystemExit("production base environment contains an invalid key")
            if key in locations:
                raise SystemExit(
                    "production base environment contains a cross-file duplicate key: "
                    + key
                )
            locations[key] = path
PY
}

validate_database_service_contract() {
  local unit environment_files direct_environment forbidden_key
  local -a expected_runtime_files
  [[ -f "$ACTIVE_DATABASE_ENV" && ! -L "$ACTIVE_DATABASE_ENV" ]] \
    || fail "双数据库发布要求活动环境文件：$ACTIVE_DATABASE_ENV"
  for unit in "${SERVICES[@]}" "${AUXILIARY_DATABASE_SERVICES[@]}" "${ONESHOT_SERVICES[@]}"; do
    environment_files="$(systemctl show "$unit" -p EnvironmentFiles --value)"
    if [[ "$ENVIRONMENT" == "production" ]]; then
      direct_environment="$(systemctl show "$unit" -p Environment --value)"
      for forbidden_key in DATABASE_URL MIGRATION_DATABASE_URL BACKUP_DATABASE_URL LOUMAI_DATABASE_PROFILE LOUMAI_DATABASE_NAME; do
        [[ "$direct_environment" != *"$forbidden_key="* ]] \
          || fail "$unit 禁止通过 Environment 直接注入数据库字段：$forbidden_key"
      done
      expected_runtime_files=("${BASE_ENV_FILES[@]}" "$ACTIVE_DATABASE_ENV")
      if [[ "$unit" == "loumai-company-management.service" ]]; then
        # Admin owns only its JWT/COS scope and a separate DML database role.
        # verify_unit_database_target still verifies its effective database/TLS.
        expected_runtime_files=(/etc/loumai/company-management-production.env /etc/loumai/company-management-production-database.env)
        [[ "$(systemctl show "$unit" -p User --value)" == "loumai-admin" ]] \
          || fail "正式管理后台必须使用独立 loumai-admin UID"
        assert_root_secret_file "${expected_runtime_files[0]}"
        assert_root_secret_file "${expected_runtime_files[1]}"
        assert_root_owned_file /usr/local/sbin/loumai-company-management-production-release
        /usr/local/sbin/loumai-company-management-production-release contract >/dev/null \
          || fail "正式管理后台独立运行配置不满足安全合同"
      fi
      /usr/bin/python3 - "$unit" "$environment_files" \
        "${expected_runtime_files[@]}" <<'PY'
import re
import sys

unit, raw, *expected_paths = sys.argv[1:]
actual_paths = re.findall(r"/[A-Za-z0-9._/-]+", raw)
if len(actual_paths) != len(set(actual_paths)):
    raise SystemExit(f"{unit} contains duplicate EnvironmentFile entries")
if actual_paths != expected_paths:
    raise SystemExit(
        f"{unit} EnvironmentFiles must exactly match the approved runtime-only files in order"
    )
PY
    else
      [[ "$environment_files" == *"$ACTIVE_DATABASE_ENV"* ]] \
        || fail "$unit 尚未加载活动数据库环境文件：$ACTIVE_DATABASE_ENV"
    fi
  done
}

validate_oneshot_contract() {
  local unit expected script configured_user configured_type configured_working_directory configured_exec configured_timer_unit enabled_state
  for unit in "${ONESHOT_SERVICES[@]}"; do
    [[ -n "$unit" ]] || continue
    case "$unit" in
      loumai-app-push-dispatcher.service)
        script="scripts/run_app_push_dispatcher.py"
        ;;
      loumai-rent-billing.service)
        script="scripts/run_rent_billing_jobs.py"
        ;;
      loumai-file-storage-cleanup.service)
        script="scripts/run_file_storage_cleanup.py"
        ;;
      *)
        fail "未识别的定时写入 service：$unit"
        ;;
    esac
    configured_user="$(systemctl show "$unit" -p User --value)"
    configured_type="$(systemctl show "$unit" -p Type --value)"
    configured_working_directory="$(systemctl show "$unit" -p WorkingDirectory --value)"
    configured_exec="$(systemctl show "$unit" -p ExecStart --value)"
    [[ "$configured_user" == "$JOB_SERVICE_USER" ]] || fail "$unit 运行用户必须是 $JOB_SERVICE_USER"
    [[ "$configured_type" == "oneshot" ]] || fail "$unit 必须是 oneshot service"
    [[ "$configured_working_directory" == "$CURRENT_LINK" ]] \
      || fail "$unit 工作目录必须是 $CURRENT_LINK"
    [[ "$configured_exec" == *"$CURRENT_LINK/.venv/bin/python"* \
      && "$configured_exec" == *"$script"* ]] \
      || fail "$unit 启动命令未指向受控脚本 $script"
    if [[ "$ENVIRONMENT" == "production" ]]; then
      enabled_state="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
      [[ "$enabled_state" == "static" ]] \
        || fail "$unit 必须保持 static，只能由受控 timer 触发（当前 $enabled_state）"
    fi
  done
  for unit in "${TIMERS[@]}"; do
    [[ -n "$unit" ]] || continue
    expected="${unit%.timer}.service"
    [[ " ${ONESHOT_SERVICES[*]} " == *" $expected "* ]] \
      || fail "$unit 缺少配对的 $expected"
    configured_timer_unit="$(systemctl show "$unit" -p Unit --value)"
    [[ "$configured_timer_unit" == "$expected" ]] \
      || fail "$unit 实际触发单元不是 $expected"
  done
}

select_database_profile() {
  local requested="$1" profile profile_file marker
  valid_database_profile "$requested" || fail "数据库 profile 非法：$requested"
  if [[ "$requested" == "active" ]]; then
    profile="$(active_database_profile)"
  else
    profile="$requested"
  fi
  if [[ "$ENVIRONMENT" == "production" && "$profile" != "cloud" ]]; then
    fail "正式服只允许 cloud 数据库 profile"
  fi
  profile_file="$(database_profile_file "$profile")"
  ENV_FILES=("${BASE_ENV_FILES[@]}")
  SELECTED_DATABASE_ENV=""

  if [[ -e "$profile_file" || -L "$profile_file" ]]; then
    assert_root_owned_directory "$DATABASE_PROFILE_DIR"
    assert_root_owned_file "$profile_file"
    ENV_FILES+=("$profile_file")
    SELECTED_DATABASE_ENV="$profile_file"
  elif [[ "$profile" != "local" ]]; then
    fail "云数据库 profile 尚未配置：$profile_file"
  elif [[ -e "$ACTIVE_DATABASE_ENV" || -L "$ACTIVE_DATABASE_ENV" ]]; then
    fail "已启用双数据库配置，但缺少本地数据库 profile：$profile_file"
  fi

  validate_environment_files
  load_app_environment
  marker="${LOUMAI_DATABASE_PROFILE:-}"
  if [[ -n "$SELECTED_DATABASE_ENV" ]]; then
    [[ "$marker" == "$profile" ]] || fail "数据库 profile 文件标记不匹配：$profile_file"
    SELECTED_DATABASE_NAME="${LOUMAI_DATABASE_NAME:-}"
    [[ "$SELECTED_DATABASE_NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
      || fail "数据库 profile 缺少合法 LOUMAI_DATABASE_NAME：$profile_file"
    validate_database_service_contract
  else
    SELECTED_DATABASE_NAME="$DATABASE_NAME"
  fi
  SELECTED_DATABASE_PROFILE="$profile"
}

switch_active_database_profile() {
  local source="$SELECTED_DATABASE_ENV" partial
  [[ -n "$source" ]] || return 0
  partial="${ACTIVE_DATABASE_ENV}.next.$$"
  rm -f -- "$partial"
  /usr/bin/python3 - "$source" "$partial" <<'PY'
import os
import re
import sys

source, destination = sys.argv[1:]
values = {}
with open(source, encoding="utf-8") as handle:
    for raw in handle:
        line = raw.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if "=" not in line:
            raise SystemExit("invalid database profile line")
        key, value = line.split("=", 1)
        key = key.strip()
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) or key in values:
            raise SystemExit("invalid or duplicate database profile key")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        if any(character in value for character in ("\x00", "\r", "\n")):
            raise SystemExit("invalid control byte in database profile")
        values[key] = value

required = ("LOUMAI_DATABASE_PROFILE", "LOUMAI_DATABASE_NAME", "DATABASE_URL")
if any(not values.get(key) for key in required):
    raise SystemExit("database profile is missing a runtime field")

def quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'

os.umask(0o077)
with open(destination, "x", encoding="utf-8") as output:
    output.write("# Generated by loumai-backend-release; migration credentials are intentionally excluded.\n")
    for key in required:
        output.write(f"{key}={quote(values[key])}\n")
    output.flush()
    os.fsync(output.fileno())
PY
  chown root:root "$partial"
  chmod 0600 "$partial"
  mv -Tf -- "$partial" "$ACTIVE_DATABASE_ENV"
  [[ "$(active_database_profile)" == "$SELECTED_DATABASE_PROFILE" ]] \
    || fail "活动数据库 profile 切换后校验失败"
}

