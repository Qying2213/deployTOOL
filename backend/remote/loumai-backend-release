wait_for_health() {
  local attempt
  for attempt in $(seq 1 30); do
    if curl -fsS --connect-timeout 2 --max-time 5 \
      -H "Host: $PUBLIC_HEALTH_AUTHORITY" "$LOCAL_HEALTH_URL" >/dev/null \
      && curl -fsS --connect-timeout 5 --max-time 10 "$PUBLIC_HEALTH_URL" >/dev/null; then
