      fi
      [[ -z "${production_uids[$uid]:-}" ]] \
        || fail "正式服进程 UID 必须隔离：$role 与 ${production_uids[$uid]} 共用 $uid"
      production_uids[$uid]="$role"
    done
  fi
  build_home="$(getent passwd "$BUILD_USER" | awk -F: '{print $6}')"
  build_shell="$(getent passwd "$BUILD_USER" | awk -F: '{print $7}')"
  [[ -n "$build_home" && -d "$build_home" && ! -L "$build_home" ]] \
