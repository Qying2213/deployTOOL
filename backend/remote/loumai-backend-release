validate_migration_database_privileges() {
  local backend="$1"
  [[ "$ENVIRONMENT" == "production" ]] || return 0
  run_migration_in_release "$backend" "$backend/.venv/bin/python" - <<'PY'
from sqlalchemy import create_engine, text
import os

engine = create_engine(os.environ["DATABASE_URL"], pool_pre_ping=True)
with engine.connect() as connection:
    audit = dict(connection.execute(text("""
        SELECT r.rolsuper, r.rolcreatedb, r.rolcreaterole, r.rolreplication,
               r.rolbypassrls,
               has_database_privilege(current_user,current_database(),'CONNECT') AS can_connect,
               has_database_privilege(current_user,current_database(),'CREATE') AS can_create_db,
               has_database_privilege(current_user,current_database(),'TEMP') AS can_temp,
               EXISTS (SELECT 1 FROM pg_roles inherited
                 WHERE inherited.rolname <> current_user
                   AND pg_has_role(current_user,inherited.oid,'MEMBER')
                   AND (inherited.rolsuper OR inherited.rolcreatedb OR inherited.rolcreaterole
                     OR inherited.rolreplication OR inherited.rolbypassrls)) AS dangerous_membership,
               has_schema_privilege(current_user,'public','USAGE') AS schema_usage,
               has_schema_privilege(current_user,'public','CREATE') AS schema_create,
               (SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
                 WHERE n.nspname NOT IN ('pg_catalog','information_schema')
                   AND n.nspname !~ '^pg_toast'
                   AND c.relkind IN ('r','p','S','v','m','f')
                   AND c.relname NOT IN ('pg_stat_statements','pg_stat_statements_info')
                   AND c.relname NOT LIKE 'tencentdb_tbl_dial_test_%'
                   AND NOT EXISTS (
                       SELECT 1 FROM pg_depend d
                        WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e'
                   )
                   AND NOT pg_has_role(current_user,c.relowner,'MEMBER')) AS foreign_owned_objects
          FROM pg_roles r WHERE r.rolname=current_user
    """)).mappings().one())
unsafe = [key for key in ('rolsuper','rolcreatedb','rolcreaterole','rolreplication',
                          'rolbypassrls','can_create_db','dangerous_membership') if audit[key]]
if (unsafe or not audit['can_connect'] or not audit['schema_usage']
        or not audit['can_temp'] or not audit['schema_create']
        or audit['foreign_owned_objects']):
    raise SystemExit('migration database role does not match the schema-owner-only contract')
print('migration database privilege contract verified')
PY
}

apply_database_role_grants() {
  local backend="$1" role_output
  local -a roles
  [[ "$ENVIRONMENT" == "production" ]] || return 0
  role_output="$(database_role_names)"
  mapfile -t roles <<<"$role_output"
  [[ "${#roles[@]}" == "2" ]] || fail "数据库角色名解析失败"
  run_migration_in_release "$backend" "$backend/.venv/bin/python" - \
    "${roles[0]}" "${roles[1]}" <<'PY'
from sqlalchemy import create_engine, text
import os
import re
import sys

runtime_role, backup_role = sys.argv[1:3]
for role in (runtime_role, backup_role):
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", role):
        raise SystemExit("invalid PostgreSQL role name")

engine = create_engine(os.environ["DATABASE_URL"], pool_pre_ping=True)
with engine.begin() as connection:
    quote = connection.dialect.identifier_preparer.quote
    runtime = quote(runtime_role)
    backup = quote(backup_role)
    statements = [
        f"ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO {runtime}",
        f"ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE TRUNCATE, REFERENCES, TRIGGER ON TABLES FROM {runtime}",
        f"ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO {runtime}",
        f"ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE UPDATE ON SEQUENCES FROM {runtime}",
        f"ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO {backup}",
        f"ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON SEQUENCES TO {backup}",
    ]
    for statement in statements:
        connection.execute(text(statement))
    objects = connection.execute(text("""
        SELECT n.nspname, c.relname, c.relkind
          FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname='public' AND c.relkind IN ('r','p','S','v','m','f')
           AND pg_has_role(current_user,c.relowner,'MEMBER')
           AND NOT EXISTS (
               SELECT 1 FROM pg_depend d
                WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e'
           )
    """)).all()
    for schema_name, object_name, object_kind in objects:
        qualified = f"{quote(schema_name)}.{quote(object_name)}"
        if object_kind in ('r','p'):
            connection.execute(text(
                f"GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE {qualified} TO {runtime}"
            ))
            connection.execute(text(
                f"REVOKE TRUNCATE, REFERENCES, TRIGGER ON TABLE {qualified} FROM {runtime}"
            ))
        if object_kind in ('r','p','v','m','f'):
            connection.execute(text(f"REVOKE ALL PRIVILEGES ON TABLE {qualified} FROM {backup}"))
            connection.execute(text(f"GRANT SELECT ON TABLE {qualified} TO {backup}"))
        if object_kind == 'S':
            connection.execute(text(
                f"GRANT USAGE, SELECT ON SEQUENCE {qualified} TO {runtime}"
            ))
            connection.execute(text(f"REVOKE UPDATE ON SEQUENCE {qualified} FROM {runtime}"))
            connection.execute(text(f"REVOKE ALL PRIVILEGES ON SEQUENCE {qualified} FROM {backup}"))
            connection.execute(text(f"GRANT SELECT ON SEQUENCE {qualified} TO {backup}"))
    if connection.execute(text("SELECT to_regclass('public.alembic_version')")).scalar_one():
        connection.execute(text(f"REVOKE ALL PRIVILEGES ON TABLE public.alembic_version FROM {runtime}"))
        connection.execute(text(f"GRANT SELECT ON TABLE public.alembic_version TO {runtime}"))
print('runtime and backup database grants reconciled')
PY
}

