  select_database_profile active
  validate_environment_files
  current="$(current_target)"
  [[ "$current" != "NONE" ]] || fail "没有当前后端，无法校验 Settings"
  [[ -x "$current/.venv/bin/python" ]] || fail "当前后端缺少 Python"

  printf 'ENV_AUDIT_PROTOCOL=1\n'
  printf 'ENV_FILE_COUNT=%s\n' "${#ENV_FILES[@]}"
  /usr/bin/python3 - "$SELECTED_DATABASE_ENV" "${ENV_FILES[@]}" <<'PY'
import base64
import re
import sys


def encode(value: str) -> str:
    return base64.b64encode(value.encode()).decode() or "-"


def parse_value(raw: str, filename: str, line_number: int) -> str:
    value = raw.strip()
    if not value:
        return ""
    if value[0] == "'":
        if len(value) < 2 or value[-1] != "'" or "'" in value[1:-1]:
            raise SystemExit(f"invalid single-quoted value: {filename}:{line_number}")
        return value[1:-1]
    if value[0] == '"':
        if len(value) < 2 or value[-1] != '"':
            raise SystemExit(f"invalid double-quoted value: {filename}:{line_number}")
        parsed: list[str] = []
        inner = value[1:-1]
        index = 0
        while index < len(inner):
            character = inner[index]
            if character == "\\" and index + 1 < len(inner) and inner[index + 1] in {'"', "\\"}:
                parsed.append(inner[index + 1])
                index += 2
                continue
            parsed.append(character)
            index += 1
        return "".join(parsed)
    if any(character.isspace() for character in value):
        raise SystemExit(f"unquoted whitespace in environment value: {filename}:{line_number}")
    return value


def sensitive(key: str) -> bool:
    return bool(
        re.search(r"(^|_)(SECRET|PASSWORD|TOKEN|CREDENTIAL|PRIVATE_KEY|ACCESS_KEY|API_KEY|APP_KEY)($|_)", key)
        or re.search(r"(^|_)(DATABASE_URL|MIGRATION_DATABASE_URL|REDIS_URL)$", key)
        or re.search(r"(_KEY|_SECRET|_PASSWORD|_TOKEN)$", key)
    )


def public(key: str) -> bool:
    if sensitive(key):
        return False
    return bool(
        key == "APP_ENVIRONMENT"
        or key in {
            "BACKEND_ALLOWED_HOSTS",
            "BACKEND_CORS_ORIGINS",
            "BACKEND_CORS_ORIGIN_REGEX",
            "BAILIAN_BASE_URL",
            "DEEPSEEK_BASE_URL",
            "GEO_WEBVIEW_ALLOWED_ORIGINS",
            "TENCENT_IM_REST_BASE_URL",
            "TIANDITU_API_BASE_URL",
            "VIDEO_TRANSCODE_WORKER_ID",
        }
        or key.startswith("RUN_")
        or key.startswith("ALLOW_")
        or re.search(r"_ENABLED$", key)
        or re.search(r"_COOKIE_SECURE$", key)
        or re.search(r"_(PROVIDER|MODE|REGION|ENGINE|ALGORITHM|PRESET|COORDINATE_SYSTEM)$", key)
        or re.search(r"_(PATH|ROOT)$", key)
        or re.search(
            r"_(SECONDS|MINUTES|HOURS|METERS|BYTES|PIXELS|EDGE|QUALITY|CONCURRENCY|THREADS|ATTEMPTS|RETRIES|FPS|CRF|SIZE)$",
            key,
        )
    )


key_pattern = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
selected_database_env = sys.argv[1]
environment_files = sys.argv[2:]
values: dict[str, str] = {}
locations: dict[str, list[str]] = {}
for filename in environment_files:
    with open(filename, encoding="utf-8") as handle:
        for line_number, raw_line in enumerate(handle, 1):
            line = raw_line.rstrip("\r\n")
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if stripped.startswith("export "):
                stripped = stripped[7:].lstrip()
            if "=" not in stripped:
                raise SystemExit(f"invalid environment line: {filename}:{line_number}")
            key, raw_value = stripped.split("=", 1)
            key = key.strip()
            if not key_pattern.fullmatch(key):
                raise SystemExit(f"invalid environment key: {filename}:{line_number}")
            value = parse_value(raw_value, filename, line_number)
            if "\x00" in value or "\n" in value or "\r" in value:
                raise SystemExit(f"invalid control byte in environment value: {filename}:{line_number}")
            values[key] = value
            locations.setdefault(key, []).append(f"{filename}:{line_number}")

for key in sorted(values):
    value = values[key]
    state = "EMPTY" if value == "" else "SET"
    visibility = "PUBLIC" if state == "SET" and public(key) else "HIDDEN"
    encoded = encode(value) if visibility == "PUBLIC" else "-"
    source = encode(locations[key][-1])
    print(f"ENV_KEY\t{key}\t{state}\t{visibility}\t{encoded}\t{source}")
for key in sorted(locations):
    key_locations = locations[key]
    intentional_database_profile_override = (
        key in {"DATABASE_URL", "MIGRATION_DATABASE_URL"}
        and selected_database_env
        and len(key_locations) == 2
        and key_locations[0].rsplit(":", 1)[0] != selected_database_env
        and key_locations[-1].rsplit(":", 1)[0] == selected_database_env
    )
    if len(key_locations) > 1 and not intentional_database_profile_override:
        print(f"ENV_DUPLICATE\t{key}\t{encode(chr(10).join(key_locations))}")
PY

  load_app_environment
  if [[ "${APP_ENVIRONMENT:-}" == "$target_environment" ]]; then
    printf 'ENV_TARGET_MATCH=1\n'
  else
    printf 'ENV_TARGET_MATCH=0\n'
  fi
  settings_output="$(run_in_release "$current" "$current/.venv/bin/python" -c '
from app.core.config import Settings


def encode(value: str) -> str:
    import base64
    return base64.b64encode(value.encode()).decode() or "-"


try:
    Settings(_env_file=None)
except Exception as exc:
    print("ENV_SETTINGS_VALID=0")
    if hasattr(exc, "errors"):
        for error in exc.errors(include_input=False, include_url=False):
            location = "_".join(str(item) for item in (error.get("loc") or ("__SETTINGS__",))).upper()
            error_type = str(error.get("type") or type(exc).__name__)
            print(f"ENV_SETTINGS_ERROR\t{encode(location)}\t{encode(error_type)}")
    else:
        root_label = encode("__SETTINGS__")
        error_type = encode(type(exc).__name__)
        print(f"ENV_SETTINGS_ERROR\t{root_label}\t{error_type}")
else:
    print("ENV_SETTINGS_VALID=1")
')"
  printf '%s\n' "$settings_output"
}

