    raise SystemExit(3)
url = urlsplit(raw_url)
if not url.scheme.startswith("postgresql"):
    raise SystemExit(4)
host = url.hostname or ""
port = int(url.port or 5432)
database = url.path.lstrip("/")
if port != 5432 or database != expected_database:
    raise SystemExit(5)
if target_environment == "production":
    query = parse_qs(url.query)
    if (query.get("sslmode") or [""])[-1] != "verify-full":
        raise SystemExit(9)
    if (query.get("sslrootcert") or [""])[-1] != expected_ca:
        raise SystemExit(10)
if expected_profile == "local":
    if host == "localhost":
        pass
    else:
        try:
            if not ipaddress.ip_address(host).is_loopback:
                raise SystemExit(6)
        except ValueError:
            raise SystemExit(6) from None
elif expected_profile == "cloud":
    if host != cloud_host:
        raise SystemExit(7)
else:
    raise SystemExit(8)
print("OK")
PY
)" || fail "服务实际数据库目标与活动 profile 不一致：$unit"
