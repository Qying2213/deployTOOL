validate_runtime_database_privileges() {
  local backend="$1" mode="${2:-full}"
  [[ "$ENVIRONMENT" == "production" ]] || return 0
  [[ "$mode" == "safety" || "$mode" == "full" ]] || fail "runtime 权限检查模式非法"
  run_in_release "$backend" "$backend/.venv/bin/python" - "$mode" <<'PY'
from sqlalchemy import create_engine, text
import os
import sys

engine = create_engine(os.environ["DATABASE_URL"], pool_pre_ping=True)
with engine.connect() as connection:
    role = dict(connection.execute(text("""
        SELECT r.rolsuper, r.rolcreatedb, r.rolcreaterole, r.rolreplication,
               r.rolbypassrls,
               has_database_privilege(current_user, current_database(), 'CONNECT') AS can_connect,
               has_database_privilege(current_user, current_database(), 'CREATE') AS can_create_db,
               has_database_privilege(current_user, current_database(), 'TEMP') AS can_temp,
               EXISTS (SELECT 1 FROM pg_roles inherited
                 WHERE inherited.rolname <> current_user
                   AND pg_has_role(current_user,inherited.oid,'MEMBER')
                   AND (inherited.rolsuper OR inherited.rolcreatedb OR inherited.rolcreaterole
                     OR inherited.rolreplication OR inherited.rolbypassrls)) AS dangerous_membership,
               (SELECT count(*) FROM pg_class c
                  JOIN pg_namespace n ON n.oid = c.relnamespace
                 WHERE n.nspname NOT IN ('pg_catalog', 'information_schema')
                   AND n.nspname !~ '^pg_toast'
                   AND c.relkind IN ('r','p','S','v','m','f')
                   AND c.relname NOT IN ('pg_stat_statements','pg_stat_statements_info')
                   AND c.relname NOT LIKE 'tencentdb_tbl_dial_test_%'
                   AND NOT EXISTS (SELECT 1 FROM pg_depend d
                     WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')
                   AND pg_has_role(current_user, c.relowner, 'MEMBER')) AS owned_objects
          FROM pg_roles r WHERE r.rolname = current_user
    """)).mappings().one())
    dangerous = [
        key for key in ('rolsuper','rolcreatedb','rolcreaterole','rolreplication',
                        'rolbypassrls','can_create_db','can_temp','dangerous_membership')
        if role[key]
    ]
    if dangerous or not role['can_connect'] or role['owned_objects']:
        raise SystemExit('runtime database role has unsafe role/database privileges')
    unsafe_schemas = connection.execute(text("""
        SELECT n.nspname FROM pg_namespace n
         WHERE n.nspname NOT IN ('pg_catalog','information_schema')
           AND n.nspname !~ '^pg_toast'
           AND has_schema_privilege(current_user, n.oid, 'CREATE')
    """)).scalars().all()
    if unsafe_schemas:
        raise SystemExit('runtime database role can CREATE in an application schema')
    missing_schema_usage = connection.execute(text("""
        SELECT DISTINCT n.nspname FROM pg_class c
          JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname NOT IN ('pg_catalog','information_schema')
           AND n.nspname !~ '^pg_toast'
           AND c.relkind IN ('r','p','S','v','m','f')
           AND c.relname NOT IN ('pg_stat_statements','pg_stat_statements_info')
           AND c.relname NOT LIKE 'tencentdb_tbl_dial_test_%'
           AND NOT EXISTS (SELECT 1 FROM pg_depend d
             WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')
           AND NOT has_schema_privilege(current_user, n.oid, 'USAGE')
    """)).scalars().all()
    missing_table_dml = connection.execute(text("""
        SELECT n.nspname || '.' || c.relname FROM pg_class c
          JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname NOT IN ('pg_catalog','information_schema')
           AND n.nspname !~ '^pg_toast' AND c.relkind IN ('r','p')
           AND c.relname NOT LIKE 'tencentdb_tbl_dial_test_%'
           AND NOT EXISTS (SELECT 1 FROM pg_depend d
             WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')
           AND NOT (n.nspname='public' AND c.relname='alembic_version')
           AND NOT (has_table_privilege(current_user,c.oid,'SELECT')
                AND has_table_privilege(current_user,c.oid,'INSERT')
                AND has_table_privilege(current_user,c.oid,'UPDATE')
                AND has_table_privilege(current_user,c.oid,'DELETE'))
    """)).scalars().all()
    unsafe_table_grants = connection.execute(text("""
        SELECT n.nspname || '.' || c.relname FROM pg_class c
          JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname NOT IN ('pg_catalog','information_schema')
           AND n.nspname !~ '^pg_toast' AND c.relkind IN ('r','p')
           AND c.relname NOT LIKE 'tencentdb_tbl_dial_test_%'
           AND NOT EXISTS (SELECT 1 FROM pg_depend d
             WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')
           AND (has_table_privilege(current_user,c.oid,'TRUNCATE')
             OR has_table_privilege(current_user,c.oid,'REFERENCES')
             OR has_table_privilege(current_user,c.oid,'TRIGGER'))
    """)).scalars().all()
    unsafe_alembic_grants = connection.execute(text("""
        SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname='public' AND c.relname='alembic_version'
           AND (NOT has_table_privilege(current_user,c.oid,'SELECT')
             OR has_table_privilege(current_user,c.oid,'INSERT')
             OR has_table_privilege(current_user,c.oid,'UPDATE')
             OR has_table_privilege(current_user,c.oid,'DELETE')
             OR has_table_privilege(current_user,c.oid,'TRUNCATE')
             OR has_table_privilege(current_user,c.oid,'REFERENCES')
             OR has_table_privilege(current_user,c.oid,'TRIGGER'))
    """)).scalars().all()
    missing_sequences = connection.execute(text("""
        SELECT n.nspname || '.' || c.relname FROM pg_class c
          JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname NOT IN ('pg_catalog','information_schema')
           AND n.nspname !~ '^pg_toast' AND c.relkind='S'
           AND NOT EXISTS (SELECT 1 FROM pg_depend d
             WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')
           AND NOT (has_sequence_privilege(current_user,c.oid,'USAGE')
                AND has_sequence_privilege(current_user,c.oid,'SELECT'))
    """)).scalars().all()
    unsafe_sequence_grants = connection.execute(text("""
        SELECT n.nspname || '.' || c.relname FROM pg_class c
          JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname NOT IN ('pg_catalog','information_schema')
           AND n.nspname !~ '^pg_toast' AND c.relkind='S'
           AND NOT EXISTS (SELECT 1 FROM pg_depend d
             WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')
           AND has_sequence_privilege(current_user,c.oid,'UPDATE')
    """)).scalars().all()
if unsafe_schemas or unsafe_table_grants or unsafe_alembic_grants or unsafe_sequence_grants:
    raise SystemExit('runtime database role has unsafe schema/table/sequence privileges')
if sys.argv[1] == 'safety':
    print('runtime database role safety verified')
    raise SystemExit(0)
if missing_schema_usage or missing_table_dml or missing_sequences:
    raise SystemExit('runtime database grants do not match the required DML-only contract')
print('runtime database privilege contract verified')
PY
}

