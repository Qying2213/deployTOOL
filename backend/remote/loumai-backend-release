}

load_recovery_marker() {
  local marker_output
  local -a fields
  recovery_marker_exists || fail "不存在数据库迁移恢复标记"
  assert_root_secret_file "$RECOVERY_FILE"
  [[ "$(stat -c '%s' "$RECOVERY_FILE")" -le 8192 ]] || fail "数据库迁移恢复标记过大"
  if ! marker_output="$(/usr/bin/python3 - "$RECOVERY_FILE" "$RELEASES_ROOT" \
    "$ENVIRONMENT" "$DATABASE_NAME" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

marker_path = Path(sys.argv[1])
releases_root = sys.argv[2]
expected_environment = sys.argv[3]
expected_database = sys.argv[4]
allowed = {
    "SCHEMA_VERSION",
    "RELEASE_ID",
    "RELEASE_PATH",
    "PREVIOUS_CURRENT",
    "DATABASE_PROFILE",
    "INITIAL",
    "PHASE",
    "START_DB_REVISION",
    "ENVIRONMENT",
    "DATABASE_NAME",
    "TARGET_REVISION",
    "COMMIT",
    "CHECKSUMS_SHA256",
}
values = {}
with marker_path.open(encoding="utf-8") as handle:
    for line_number, raw in enumerate(handle, 1):
        line = raw.rstrip("\r\n")
        if not line or "=" not in line:
            raise SystemExit(f"invalid recovery marker line {line_number}")
        key, value = line.split("=", 1)
        if key not in allowed or key in values:
            raise SystemExit(f"invalid recovery marker key {key}")
        if not value or any(character.isspace() for character in value):
            raise SystemExit(f"invalid recovery marker value for {key}")
        values[key] = value
if set(values) != allowed or values["SCHEMA_VERSION"] != "1":
    raise SystemExit("invalid recovery marker schema")
if values["ENVIRONMENT"] != expected_environment or values["DATABASE_NAME"] != expected_database:
    raise SystemExit("recovery marker environment/database mismatch")
release_id = values["RELEASE_ID"]
if not re.fullmatch(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,12}", release_id):
    raise SystemExit("invalid recovery release id")
release_path = values["RELEASE_PATH"]
if release_path != f"{releases_root}/{release_id}/backend":
    raise SystemExit("recovery release path is outside the controlled release root")
previous = values["PREVIOUS_CURRENT"]
if previous != "NONE" and not re.fullmatch(
    re.escape(releases_root) + r"/[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,12}/backend",
    previous,
):
    raise SystemExit("recovery previous release path is invalid")
if values["DATABASE_PROFILE"] not in {"local", "cloud"}:
    raise SystemExit("invalid recovery database profile")
if values["INITIAL"] not in {"true", "false"}:
    raise SystemExit("invalid recovery initial flag")
if values["PHASE"] not in {"prepared", "stopped", "migrating"}:
    raise SystemExit("invalid recovery phase")
if not re.fullmatch(r"[A-Za-z0-9_]+", values["START_DB_REVISION"]):
    raise SystemExit("invalid recovery start database revision")
if not re.fullmatch(r"[A-Za-z0-9_]+", values["TARGET_REVISION"]):
    raise SystemExit("invalid recovery target database revision")
if not re.fullmatch(r"[0-9a-f]{40}", values["COMMIT"]):
    raise SystemExit("invalid recovery commit")
if not re.fullmatch(r"[0-9a-f]{64}", values["CHECKSUMS_SHA256"]):
    raise SystemExit("invalid recovery checksums digest")
release_json = Path(release_path, "release.json")
checksums = Path(release_path, "SHA256SUMS")
metadata = json.loads(release_json.read_text(encoding="utf-8"))
if (
    metadata.get("release_id") != release_id
    or metadata.get("environment") != expected_environment
    or metadata.get("artifact_db_head") != values["TARGET_REVISION"]
    or metadata.get("commit") != values["COMMIT"]
):
    raise SystemExit("recovery marker release metadata mismatch")
if hashlib.sha256(checksums.read_bytes()).hexdigest() != values["CHECKSUMS_SHA256"]:
    raise SystemExit("recovery marker checksums digest mismatch")
for key in (
    "RELEASE_ID",
    "RELEASE_PATH",
    "PREVIOUS_CURRENT",
    "DATABASE_PROFILE",
    "INITIAL",
    "PHASE",
    "START_DB_REVISION",
    "TARGET_REVISION",
    "COMMIT",
    "CHECKSUMS_SHA256",
):
    print(values[key])
PY
)"; then
    fail "数据库迁移恢复标记格式非法"
  fi
  mapfile -t fields <<<"$marker_output"
  [[ "${#fields[@]}" == "10" ]] || fail "数据库迁移恢复标记字段数量非法"
  RECOVERY_RELEASE_ID="${fields[0]}"
  RECOVERY_RELEASE="${fields[1]}"
  RECOVERY_PREVIOUS_CURRENT="${fields[2]}"
  RECOVERY_DATABASE_PROFILE="${fields[3]}"
  RECOVERY_INITIAL="${fields[4]}"
  RECOVERY_PHASE="${fields[5]}"
  RECOVERY_START_DB_REVISION="${fields[6]}"
  RECOVERY_TARGET_REVISION="${fields[7]}"
