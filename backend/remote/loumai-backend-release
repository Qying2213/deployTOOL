                "partitioned_table": "p",
                "pg_catalog": "pg_catalog",
                "information_schema": "information_schema",
                "toast_pattern": "^pg_toast",
            },
        ).all()
        application_tables = [
            f"{schema}.{name}"
            for schema, name in tables
            if not (
                schema == "public"
                and (
                    name in managed_public_tables
                    or name.startswith("tencentdb_tbl_dial_test_")
                )
            )
        ]
        if application_tables:
            names = ", ".join(application_tables[:5])
            raise SystemExit(
                "unversioned non-empty database; refusing automatic migration: " + names
            )
        print("base")'
}

