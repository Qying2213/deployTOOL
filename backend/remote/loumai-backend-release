policy = values.get("BACKUP_POLICY_REFERENCE", "")
if not re.fullmatch(
    r"tencentdb-postgresql/[a-z0-9-]{3,32}/postgres-[a-z0-9]{6,64}/[A-Za-z0-9._-]{6,128}",
    policy,
):
    raise SystemExit("production backup policy reference is invalid")
raw_drill = values.get("LAST_RESTORE_DRILL_UTC", "")
try:
    drill = datetime.fromisoformat(raw_drill.replace("Z", "+00:00"))
except ValueError as exc:
    raise SystemExit("production restore drill timestamp is invalid") from exc
if drill.tzinfo is None:
    raise SystemExit("production restore drill timestamp must include UTC offset")
now = datetime.now(timezone.utc)
drill = drill.astimezone(timezone.utc)
if drill > now + timedelta(minutes=5) or drill < now - timedelta(days=90):
    raise SystemExit("production restore drill must be successful within the last 90 days")
PY
}

validate_server_contract() {
  local deploy_uid service_uid build_uid build_home build_shell role user uid user_shell
  local -A production_uids=()
  [[ "$STAGING_ROOT" == "$REMOTE_ROOT/incoming" ]] || fail "staging 必须位于受控后端根目录"
