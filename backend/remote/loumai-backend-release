create_database_backup() (
  local release_id="$1"
  local backup="$BACKUP_ROOT/${SELECTED_DATABASE_PROFILE}_${SELECTED_DATABASE_NAME}_before_${release_id}.dump"
  local partial sha_partial digest metadata passfile host port username database sslmode sslrootcert backup_group
	local -a pg_environment
  load_app_environment
  [[ "$(backup_root_status)" == "ready" ]] \
    || fail "数据库备份目录尚未准备完成：$BACKUP_ROOT"
  partial="$BACKUP_ROOT/.${SELECTED_DATABASE_PROFILE}_${SELECTED_DATABASE_NAME}_before_${release_id}.dump.partial.$$"
  sha_partial="$BACKUP_ROOT/.${SELECTED_DATABASE_PROFILE}_${SELECTED_DATABASE_NAME}_before_${release_id}.dump.sha256.partial.$$"
  metadata="$(mktemp "$REMOTE_ROOT/.database-backup-metadata.XXXXXX")"
  passfile="$(mktemp "$BACKUP_ROOT/.pgpass.XXXXXX")"
  trap 'rm -f -- "$metadata" "$passfile" "$partial" "$sha_partial"' EXIT INT TERM HUP
  chmod 0600 "$metadata" "$passfile"
  backup_group="$(id -gn "$BACKUP_USER")"
  chown "$BACKUP_USER:$backup_group" "$passfile"
  [[ ! -e "$backup" && ! -L "$backup" ]] || fail "数据库备份已存在：$backup"
  [[ ! -e "$partial" && ! -e "$sha_partial" ]] || fail "数据库临时备份路径已存在"
  if ! /usr/bin/python3 - "$metadata" "$passfile" <<'PY'
import os
import sys
from urllib.parse import parse_qs, unquote, urlsplit

metadata_path, passfile_path = sys.argv[1:3]
raw = os.getenv("BACKUP_DATABASE_URL")
if not raw and os.getenv("APP_ENVIRONMENT") != "production":
    raw = os.getenv("MIGRATION_DATABASE_URL") or os.getenv("DATABASE_URL")
if not raw:
    raise SystemExit("missing independent backup database URL")
url = urlsplit(raw)
if not url.scheme.startswith("postgresql"):
    raise SystemExit("backup target must use PostgreSQL")
host = url.hostname or "localhost"
port = int(url.port or 5432)
username = unquote(url.username or "")
password = unquote(url.password or "")
database = unquote(url.path.lstrip("/"))
query = parse_qs(url.query)
sslmode = (query.get("sslmode") or ["prefer"])[-1]
sslrootcert = (query.get("sslrootcert") or [""])[-1]
if not username or not database or not (1 <= port <= 65535):
    raise SystemExit("incomplete PostgreSQL backup target")
if any("\x00" in value or "\r" in value or "\n" in value for value in (
    host,
    username,
    password,
    database,
    sslmode,
    sslrootcert,
)):
    raise SystemExit("invalid control byte in PostgreSQL backup target")

def pgpass_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace(":", "\\:")

with open(passfile_path, "w", encoding="utf-8") as handle:
    fields = [host, str(port), database, username, password]
    handle.write(":".join(pgpass_escape(field) for field in fields) + "\n")
os.chmod(passfile_path, 0o600)
with open(metadata_path, "wb") as handle:
    for value in (host, str(port), username, database, sslmode, sslrootcert):
        handle.write(value.encode() + b"\0")
PY
  then
    rm -f -- "$partial" "$sha_partial"
    return 1
  fi
  if ! {
    IFS= read -r -d '' host \
      && IFS= read -r -d '' port \
      && IFS= read -r -d '' username \
      && IFS= read -r -d '' database \
      && IFS= read -r -d '' sslmode \
      && IFS= read -r -d '' sslrootcert
  } < "$metadata"; then
    rm -f -- "$partial" "$sha_partial"
    return 1
  fi
  if [[ -z "$host" || -z "$port" || -z "$username" || -z "$database" || -z "$sslmode" ]]; then
    printf 'ERROR: 数据库备份连接元数据读取不完整。\n' >&2
    rm -f -- "$partial" "$sha_partial"
    return 1
  fi
  rm -f -- "$metadata"
  if [[ "$ENVIRONMENT" == "production" ]]; then
    [[ "$sslmode" == "verify-full" && "$sslrootcert" == "$DATABASE_CA_FILE" ]] \
      || fail "正式服数据库备份必须使用配置的 CA 和 sslmode=verify-full"
  fi
  pg_environment=(PGPASSFILE="$passfile" PGSSLMODE="$sslmode")
  [[ -z "$sslrootcert" ]] || pg_environment+=(PGSSLROOTCERT="$sslrootcert")
  if ! run_as_clean "$BACKUP_USER" /usr/bin/env -i \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 "${pg_environment[@]}" \
    /usr/bin/pg_dump -Fc --no-owner --no-acl --host "$host" --port "$port" \
    --username "$username" --dbname "$database" --file "$partial"; then
    rm -f -- "$partial" "$sha_partial"
    return 1
  fi
  rm -f -- "$passfile"
  if ! run_as_clean "$BACKUP_USER" /usr/bin/env -i \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 \
    /usr/bin/pg_restore --list "$partial" >/dev/null; then
    rm -f -- "$partial" "$sha_partial"
    return 1
  fi
  digest="$(sha256sum "$partial" | awk '{print $1}')"
  printf '%s  %s\n' "$digest" "$(basename "$backup")" > "$sha_partial"
  chmod 0600 "$partial" "$sha_partial"
  chown "$BACKUP_USER:$backup_group" "$partial" "$sha_partial"
  mv -- "$partial" "$backup"
  mv -- "$sha_partial" "$backup.sha256"
  printf 'BACKUP=%s\n' "$backup"
)

