validate_runtime_tools() {
	assert_root_owned_directory "$RUNTIME_ROOT"
	[[ "$UV_BIN" == "$RUNTIME_ROOT/"* && "$BASE_PYTHON" == "$RUNTIME_ROOT/"* ]] \
		|| fail "uv/Python 必须位于受控 runtime 根目录"
  [[ -x "$UV_BIN" && ! -L "$UV_BIN" ]] || fail "uv 不存在或是软链接：$UV_BIN"
  [[ -x "$BASE_PYTHON" && ! -L "$BASE_PYTHON" ]] || fail "基础 Python 不存在或是软链接：$BASE_PYTHON"
  [[ -z "$(find "$RUNTIME_ROOT" \( -type d -o -type f \) ! -user root -print -quit)" ]] \
		|| fail "runtime 必须完全归 root 所有"
  [[ -z "$(find "$RUNTIME_ROOT" \( -type d -o -type f \) -perm /022 -print -quit)" ]] \
		|| fail "runtime 不能被非 root 写入"
	local link resolved
	while IFS= read -r -d '' link; do
		[[ "$(stat -c '%u' "$link")" == "0" ]] || fail "runtime 软链接必须归 root 所有：$link"
		resolved="$(readlink -f "$link")"
		[[ -e "$resolved" && "$resolved" == "$RUNTIME_ROOT/"* ]] \
			|| fail "runtime 软链接越界或失效：$link"
	done < <(find "$RUNTIME_ROOT" -type l -print0)
}

validate_backup_root() {
  local backup_uid owner_uid
  assert_root_owned_directory "${BACKUP_ROOT%/*}"
  [[ -d "$BACKUP_ROOT" && ! -L "$BACKUP_ROOT" ]] || fail "数据库备份目录不存在"
  [[ "$(readlink -f "$BACKUP_ROOT")" == "$BACKUP_ROOT" ]] || fail "备份目录路径包含软链接"
  backup_uid="$(id -u "$BACKUP_USER")"
  owner_uid="$(stat -c '%u' "$BACKUP_ROOT")"
  [[ "$owner_uid" == "0" || "$owner_uid" == "$backup_uid" ]] \
		|| fail "备份目录必须归 root 或 $BACKUP_USER 所有"
  [[ -z "$(find "$BACKUP_ROOT" -maxdepth 0 -perm /022 -print -quit)" ]] \
		|| fail "备份目录不能被组或其他用户写入"
}

backup_root_status() {
  local backup_uid owner_uid mode
  backup_uid="$(id -u "$BACKUP_USER")"
  owner_uid="$(stat -c '%u' "$BACKUP_ROOT")"
  mode="$(stat -c '%a' "$BACKUP_ROOT")"
  if [[ "$owner_uid" == "$backup_uid" && "$mode" == "700" ]] \
    && run_as_clean "$BACKUP_USER" /usr/bin/test -w "$BACKUP_ROOT" \
    && run_as_clean "$BACKUP_USER" /usr/bin/test -x "$BACKUP_ROOT"; then
    printf 'ready\n'
  else
    printf 'repairable\n'
  fi
}

backup_root_available_bytes() {
  df -PB1 "$BACKUP_ROOT" | awk 'NR==2 {print $4}'
}

prepare_backup_root() {
  local backup_group probe
  validate_backup_root
  backup_group="$(id -gn "$BACKUP_USER")"
  chown "$BACKUP_USER:$backup_group" "$BACKUP_ROOT"
  chmod 0700 "$BACKUP_ROOT"
  probe="$(run_as_clean "$BACKUP_USER" /usr/bin/mktemp "$BACKUP_ROOT/.write-check.XXXXXX")" \
    || fail "$BACKUP_USER 无法在数据库备份目录创建文件：$BACKUP_ROOT"
  [[ -f "$probe" && ! -L "$probe" ]] || fail "数据库备份目录写入探针异常"
  rm -f -- "$probe"
  [[ "$(backup_root_status)" == "ready" ]] \
    || fail "数据库备份目录自动修复后仍不可用：$BACKUP_ROOT"
  [[ "$(backup_root_available_bytes)" -ge "$BACKUP_MIN_FREE_BYTES" ]] \
    || fail "数据库备份目录剩余空间低于发布门禁：$BACKUP_MIN_FREE_BYTES bytes"
}

