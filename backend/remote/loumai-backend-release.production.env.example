# Install as /etc/loumai/backend-release.env; root:root and mode 0644 or stricter.
# This file contains deployment topology only. Application and database secrets belong
# in root-owned 0600 files under /etc/loumai and must never be copied back to Git.
LOUMAI_BACKEND_ENVIRONMENT=production
LOUMAI_BACKEND_REMOTE_ROOT=/srv/loumai-backend
LOUMAI_BACKEND_STAGING_ROOT=/srv/loumai-backend/incoming
LOUMAI_BACKEND_DEPLOY_USER=loumai-deploy
LOUMAI_BACKEND_SERVICE_USER=loumai-api
LOUMAI_BACKEND_VIDEO_SERVICE_USER=loumai-video
LOUMAI_BACKEND_IM_SERVICE_USER=loumai-im
LOUMAI_BACKEND_JOB_SERVICE_USER=loumai-jobs
LOUMAI_BACKEND_MIGRATION_USER=loumai-migrate
LOUMAI_BACKEND_BUILD_USER=loumai-build
LOUMAI_BACKEND_CURRENT_LINK=/srv/loumai-backend/backend-current
LOUMAI_BACKEND_ENV_FILES="/etc/loumai/backend.env /etc/loumai/sms.env"
LOUMAI_BACKEND_UV_BIN=/opt/loumai-runtime/bin/uv
LOUMAI_BACKEND_BASE_PYTHON=/opt/loumai-runtime/python/cpython-3.12.13-linux-x86_64-gnu/bin/python3.12
LOUMAI_BACKEND_RUNTIME_ROOT=/opt/loumai-runtime
LOUMAI_BACKEND_DATABASE_NAME=LOUMAI_PRODUCTION_DATABASE
LOUMAI_BACKEND_DATABASE_PROFILE_DIR=/etc/loumai/database-profiles
LOUMAI_BACKEND_ACTIVE_DATABASE_ENV=/etc/loumai/database-active.env
# Use the TencentDB DNS endpoint whose certificate name can be verified. Do not use an IP.
LOUMAI_BACKEND_CLOUD_DATABASE_HOST=postgres.production.example.com
LOUMAI_BACKEND_DATABASE_CA_FILE=/etc/loumai/certs/tencentdb-ca.pem
LOUMAI_BACKEND_DATABASE_CA_GROUP=loumai-db-ca
LOUMAI_BACKEND_BACKUP_ROOT=/var/backups/loumai
LOUMAI_BACKEND_BACKUP_USER=loumai-backup
LOUMAI_BACKEND_BACKUP_MIN_FREE_BYTES=10737418240
LOUMAI_BACKEND_OFFSITE_BACKUP_EVIDENCE_FILE=/etc/loumai/production-backup-evidence.env
LOUMAI_BACKEND_SERVICES="loumai-video-worker.service loumai-im-worker.service loumai-api.service"
# Keep the independent management backend outside the first production release until it has
# its own audited production deployment contract. Add it only after that rollout exists.
LOUMAI_BACKEND_AUXILIARY_DATABASE_SERVICES=""
LOUMAI_BACKEND_ONESHOT_SERVICES="loumai-file-storage-cleanup.service loumai-rent-billing.service loumai-app-push-dispatcher.service"
LOUMAI_BACKEND_TIMERS="loumai-file-storage-cleanup.timer loumai-rent-billing.timer loumai-app-push-dispatcher.timer"
LOUMAI_BACKEND_VIDEO_SERVICE=loumai-video-worker.service
LOUMAI_BACKEND_FFMPEG_BIN=/opt/loumai-runtime/ffmpeg/bin/ffmpeg
LOUMAI_BACKEND_FFPROBE_BIN=/opt/loumai-runtime/ffmpeg/bin/ffprobe
LOUMAI_BACKEND_VIDEO_TEMP_ROOT=/var/lib/loumai-video/tmp
# Keep false until COS versioning, STS/CAM, CORS, Mini Program upload domain and four clients pass.
LOUMAI_BACKEND_PROPERTY_VIDEO_DIRECT_UPLOAD_APPROVED=false
# Keep false until the security owner explicitly accepts the temporary shared Settings secret scope.
LOUMAI_BACKEND_MONOLITHIC_SETTINGS_SECRET_SCOPE_APPROVED=false
# Keep false for managed Redis. Set true only when the owner explicitly accepts a temporary,
# loopback-only TLS Redis on the single production CVM.
LOUMAI_BACKEND_LOCAL_REDIS_APPROVED=false
LOUMAI_BACKEND_LOCAL_HEALTH_URL=http://127.0.0.1:8000/health
LOUMAI_BACKEND_PUBLIC_HEALTH_URL=https://api.yinlizhangyu.com/health
