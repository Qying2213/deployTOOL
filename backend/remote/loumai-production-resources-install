#!/usr/bin/env bash

set -euo pipefail
umask 077

readonly BACKEND_PENDING=/etc/loumai/backend.env.pending
readonly SMS_PENDING=/etc/loumai/sms.env.pending
readonly REDIS_CA=/etc/loumai/certs/tencent-redis-ca.pem
readonly MODE="${1:-all}"

fail() {
  printf '错误：%s\n' "$*" >&2
  exit 1
}

[[ "${EUID}" -eq 0 ]] || fail "请使用 sudo 运行"
[[ -t 0 && -t 1 ]] || fail "该工具只能在服务器交互式终端中运行"
[[ "$MODE" == "all" || "$MODE" == "--cos-only" ]] \
  || fail "用法：loumai-production-resources-install [--cos-only]"
[[ -f "$BACKEND_PENDING" && ! -L "$BACKEND_PENDING" ]] \
  || fail "缺少待激活业务配置：$BACKEND_PENDING"
[[ -f "$SMS_PENDING" && ! -L "$SMS_PENDING" ]] \
  || fail "缺少待激活短信配置：$SMS_PENDING"
[[ "$(stat -c '%U:%G:%a' "$BACKEND_PENDING")" == "root:root:600" ]] \
  || fail "$BACKEND_PENDING 必须是 root:root 0600"
[[ "$(stat -c '%U:%G:%a' "$SMS_PENDING")" == "root:root:600" ]] \
  || fail "$SMS_PENDING 必须是 root:root 0600"
if [[ "$MODE" == "all" ]]; then
  [[ -f "$REDIS_CA" && ! -L "$REDIS_CA" ]] \
    || fail "请先把腾讯云 Redis CA 证书安装到 $REDIS_CA"
  [[ "$(stat -c '%U:%G' "$REDIS_CA")" == "root:root" ]] \
    || fail "$REDIS_CA 必须归 root:root 所有"
  [[ -z "$(find "$REDIS_CA" -maxdepth 0 -perm /022 -print -quit)" ]] \
    || fail "$REDIS_CA 不能允许组或其他用户写入"
  /usr/bin/openssl x509 -in "$REDIS_CA" -noout >/dev/null 2>&1 \
    || fail "$REDIS_CA 不是有效的 PEM X.509 证书"

  read -r -p 'Redis 内网 IPv4（必须属于正式服 172.27.0.0/16）：' REDIS_HOST
  read -r -p 'Redis TLS 端口 [6379]：' REDIS_PORT
  REDIS_PORT="${REDIS_PORT:-6379}"
  read -r -p 'Redis 数据库编号 [0]：' REDIS_DATABASE
  REDIS_DATABASE="${REDIS_DATABASE:-0}"
  read -r -s -p 'Redis 鉴权串（输入不回显）：' REDIS_AUTH
  printf '\n'
fi
read -r -p 'COS 地域简称 [ap-chengdu]：' COS_REGION
COS_REGION="${COS_REGION:-ap-chengdu}"
read -r -p 'COS 正式 Bucket 全名（含 APPID）：' COS_BUCKET
read -r -s -p 'COS CAM SecretId（输入不回显）：' COS_SECRET_ID
printf '\n'
read -r -s -p 'COS CAM SecretKey（输入不回显）：' COS_SECRET_KEY
printf '\n'

export LOUMAI_RESOURCES_MODE="$MODE"
if [[ "$MODE" == "all" ]]; then
  export REDIS_HOST REDIS_PORT REDIS_DATABASE REDIS_AUTH
fi
export COS_REGION COS_BUCKET COS_SECRET_ID COS_SECRET_KEY
/usr/bin/python3 - "$BACKEND_PENDING" <<'PY'
import ipaddress
import os
import re
import sys
from pathlib import Path
from urllib.parse import quote, urlsplit


path = Path(sys.argv[1])


def required(name: str, *, minimum: int = 1) -> str:
    value = os.environ.get(name, "").strip()
    if len(value) < minimum or any(character in value for character in "\0\r\n"):
        raise SystemExit(f"{name} 无效或为空")
    return value


cos_only = os.environ.get("LOUMAI_RESOURCES_MODE") == "--cos-only"
if not cos_only:
    redis_host = required("REDIS_HOST")
    try:
        redis_address = ipaddress.ip_address(redis_host)
    except ValueError as exc:
        raise SystemExit("REDIS_HOST 必须是腾讯云控制台显示的内网 IPv4") from exc
    production_vpc = ipaddress.ip_network("172.27.0.0/16")
    if redis_address not in production_vpc or redis_address.is_loopback:
        raise SystemExit("REDIS_HOST 不属于正式服务器 VPC 172.27.0.0/16")

    try:
        redis_port = int(required("REDIS_PORT"))
        redis_database = int(required("REDIS_DATABASE"))
    except ValueError as exc:
        raise SystemExit("Redis 端口和数据库编号必须是整数") from exc
    if not 1 <= redis_port <= 65535:
        raise SystemExit("Redis 端口超出有效范围")
    if not 0 <= redis_database <= 15:
        raise SystemExit("Redis 数据库编号必须在 0 到 15 之间")
    redis_auth = required("REDIS_AUTH", minimum=8)

cos_region = required("COS_REGION")
if not re.fullmatch(r"[a-z]{2,8}-[a-z0-9-]{2,32}", cos_region):
    raise SystemExit("COS_REGION 不是有效的腾讯云地域简称")
cos_bucket = required("COS_BUCKET")
if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,48}-[0-9]{5,20}", cos_bucket):
    raise SystemExit("COS_BUCKET 必须是含 APPID 的完整 Bucket 名称")
if re.search(r"(^|-)(test|testing|dev|staging)(-|$)", cos_bucket):
    raise SystemExit("COS_BUCKET 看起来仍是测试资源")
cos_secret_id = required("COS_SECRET_ID", minimum=16)
cos_secret_key = required("COS_SECRET_KEY", minimum=16)

values = {}
for line_number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
    line = raw.strip()
    if not line or line.startswith(("#", ";")):
        continue
    key, separator, raw_value = line.partition("=")
    if not separator or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
        raise SystemExit(f"待激活配置第 {line_number} 行格式错误")
    if key in values:
        raise SystemExit(f"待激活配置存在重复变量：{key}")
    value = raw_value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        value = value[1:-1]
    values[key] = value.replace("\\\"", '"').replace("\\\\", "\\")

if cos_only:
    existing_redis = urlsplit(values.get("REDIS_URL", ""))
    if existing_redis.scheme != "rediss" or existing_redis.hostname != "127.0.0.1":
        raise SystemExit("--cos-only 要求待激活配置已包含获批的本机 TLS Redis")
else:
    redis_ca = quote("/etc/loumai/certs/tencent-redis-ca.pem", safe="")
    values["REDIS_URL"] = (
        f"rediss://:{quote(redis_auth, safe='')}@{redis_host}:{redis_port}/{redis_database}"
        f"?ssl_cert_reqs=required&ssl_ca_certs={redis_ca}&ssl_check_hostname=True"
    )
values.update({
    "TENCENT_COS_REGION": cos_region,
    "TENCENT_COS_BUCKET": cos_bucket,
    "TENCENT_COS_SECRET_ID": cos_secret_id,
    "TENCENT_COS_SECRET_KEY": cos_secret_key,
})


def encode(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


temporary = path.with_suffix(path.suffix + ".new")
temporary.write_text(
    "".join(f"{key}={encode(value)}\n" for key, value in sorted(values.items())),
    encoding="utf-8",
)
os.chown(temporary, 0, 0)
os.chmod(temporary, 0o600)
os.replace(temporary, path)
print("正式资源已安全写入待激活配置；未输出任何密钥。")
PY
unset REDIS_HOST REDIS_PORT REDIS_DATABASE REDIS_AUTH
unset COS_REGION COS_BUCKET COS_SECRET_ID COS_SECRET_KEY
unset LOUMAI_RESOURCES_MODE

printf '下一步：通知部署负责人执行连通性校验和首次 bootstrap。\n'
