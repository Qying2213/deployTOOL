# Install as /etc/loumai/production-backup-evidence.env; root:root mode 0600.
# Replace every placeholder only after a real TencentDB restore drill succeeds.
PROVIDER=tencentdb-postgresql
AUTOMATIC_BACKUP_ENABLED=true
OFFSITE_OR_IMMUTABLE_COPY_ENABLED=true
BACKUP_POLICY_REFERENCE=tencentdb-postgresql/REPLACE_REGION/postgres-REPLACE_INSTANCE/REPLACE_POLICY_ID
LAST_RESTORE_DRILL_UTC=REPLACE_WITH_ISO_8601_UTC_TIMESTAMP
