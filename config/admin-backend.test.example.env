# 管理后台后端源码目录。测试服固定发布已推送的 test 分支。
ADMIN_BACKEND_REPO=/Users/qinyang/Desktop/zuling/conpanyManagement
ADMIN_BACKEND_PYTHON_BIN=/Users/qinyang/Desktop/zuling/conpanyManagement/.venv/bin/python
ADMIN_BACKEND_RUNTIME_CONSTRAINTS=/Users/qinyang/Desktop/zuling/deploy--loumai/admin-backend/runtime-constraints.test.txt
ADMIN_BACKEND_EXPECTED_BRANCH=test

# 测试服 SSH。配置文件只能保存私钥路径，禁止保存私钥内容或密码。
ADMIN_BACKEND_DEPLOY_TARGET=ubuntu@132.232.220.115
ADMIN_BACKEND_SSH_PORT=22
ADMIN_BACKEND_SSH_IDENTITY_FILE=/Users/qinyang/.ssh/loumai_test_hexhub

# 服务器受控发布目录与 helper。
ADMIN_BACKEND_REMOTE_ROOT=/srv/loumai-company-management
ADMIN_BACKEND_REMOTE_HELPER=/usr/local/sbin/loumai-company-management-release
ADMIN_BACKEND_REMOTE_STAGING_ROOT=/srv/loumai-company-management/incoming
ADMIN_BACKEND_REMOTE_USE_SUDO=true

# 公网探针只用于发布后验收；API 仍由 Nginx /admin-api/ 反代到 127.0.0.1:8100。
