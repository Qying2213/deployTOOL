# Copy to admin-frontend.production.local.env (Git ignored). No application secrets.
ADMIN_FRONTEND_ENVIRONMENT=production
ADMIN_FRONTEND_DEPLOY_TARGET=loumai-deploy@production-server
ADMIN_FRONTEND_SSH_PORT=22
ADMIN_FRONTEND_SSH_IDENTITY_FILE=/absolute/path/to/production-deploy-key
# Confirm the actual admin domain and DNS before using any production command.
ADMIN_FRONTEND_PUBLIC_URL=https://admin.example.com
