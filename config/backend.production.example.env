# Copy to config/backend.production.local.env. The local file is ignored by Git.
# Store only paths and addresses here; never store passwords, tokens, or key contents.
BACKEND_ENVIRONMENT=production
BACKEND_REPO=/absolute/path/to/loumai-ai
BACKEND_PYTHON_BIN=/absolute/path/to/loumai-ai/.venv311/bin/python
BACKEND_RUNTIME_CONSTRAINTS=/absolute/path/to/deploy--loumai/backend/runtime-constraints.production.txt
BACKEND_EXPECTED_BRANCH=master
BACKEND_REQUIRE_UPSTREAM_MATCH=true

# Keep the real production IP or SSH alias only in the ignored .local.env copy.
BACKEND_DEPLOY_TARGET=DEPLOY_USER@production-server
BACKEND_SSH_PORT=22
BACKEND_SSH_IDENTITY_FILE=
BACKEND_PUBLIC_URL=https://api.yinlizhangyu.com
BACKEND_REMOTE_STAGING_ROOT=/srv/loumai-backend/incoming
BACKEND_REMOTE_HELPER=/usr/local/sbin/loumai-backend-release
BACKEND_REMOTE_USE_SUDO=true
