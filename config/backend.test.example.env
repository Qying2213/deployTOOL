# Copy to backend.test.local.env. The local file is ignored by Git.
# Store only paths and addresses here; never store passwords, tokens, or key contents.
BACKEND_ENVIRONMENT=test
BACKEND_REPO=/absolute/path/to/loumai-ai
BACKEND_PYTHON_BIN=/absolute/path/to/loumai-ai/.venv311/bin/python
BACKEND_RUNTIME_CONSTRAINTS=/absolute/path/to/deploy--loumai/backend/runtime-constraints.test.txt
BACKEND_EXPECTED_BRANCH=master
BACKEND_REQUIRE_UPSTREAM_MATCH=true

BACKEND_DEPLOY_TARGET=DEPLOY_USER@test-server
BACKEND_SSH_PORT=22
BACKEND_SSH_IDENTITY_FILE=
BACKEND_PUBLIC_URL=https://test.yinlizhangyu.com
BACKEND_REMOTE_STAGING_ROOT=/srv/loumai-backend/incoming
BACKEND_REMOTE_HELPER=/usr/local/sbin/loumai-backend-release
BACKEND_REMOTE_USE_SUDO=true
# Allows only an explicitly requested --sync-helper operation on ENVIRONMENT=test.
# The SSH account must be able to run the streamed, checksum-bound installer via sudo -n.
BACKEND_TEST_HELPER_SYNC_ENABLED=false
