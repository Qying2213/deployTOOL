# Copy to config/frontend.production.local.env. The local file must be ignored by Git.
# Replace every placeholder with the production host's own target, key and public URL.
H5_DEPLOY_ENV=production
H5_FRONTEND_REPO=/absolute/path/to/qiye-qianduan
H5_DEPLOY_TARGET=DEPLOY_USER@production-server
H5_SSH_PORT=22
H5_SSH_IDENTITY_FILE=/absolute/path/to/production-deploy-key

H5_PUBLIC_URL=https://h5.example.com
H5_EXPECTED_BRANCH=main
H5_REQUIRE_UPSTREAM_MATCH=true

H5_HBUILDERX_ROOT=/Applications/HBuilderX.app/Contents/HBuilderX
H5_EXPECTED_HBUILDERX_VERSION=5.14.2026070214
H5_EXPECTED_UNI_VERSION=5.14.2026062517.4248
H5_EXPECTED_HBUILDERX_NODE_VERSION=v22.22.2
H5_EXPECTED_SASS_VERSION=1.43.4
H5_EXPECTED_SASS_PLUGIN_VERSION=0.0.3
H5_EXPECTED_TITLE=工位有方

# Must match LOUMAI_H5_STAGING_ROOT on the production server helper.
H5_REMOTE_STAGING_ROOT=/srv/loumai-h5-production/incoming
H5_REMOTE_HELPER=/usr/local/sbin/loumai-h5-release
# true: call the root-owned helper through passwordless sudo; false: SSH user is root.
H5_REMOTE_USE_SUDO=true
