WEBSITE_BACKEND_REPO=/absolute/path/to/P1-WEB-01-backend
WEBSITE_FRONTEND_REPO=/absolute/path/to/P1-WEB-01-frontend
WEBSITE_PRODUCTION_TARGET=ubuntu@production.example
WEBSITE_PRODUCTION_IPV4=203.0.113.10
WEBSITE_PRODUCTION_KEY=/absolute/path/to/production-ssh-key
WEBSITE_OLD_TARGET=ubuntu@old-website.example
WEBSITE_OLD_IPV4=203.0.113.20
WEBSITE_OLD_KEY=/absolute/path/to/old-website-ssh-key
# Only local PostgreSQL may be used for isolated tests; never use either cloud database.
WEBSITE_LOCAL_GATE_DATABASE_URL=postgresql+psycopg://developer@127.0.0.1:5432/postgres
WEBSITE_LOCAL_PYTHON=/absolute/path/to/python
