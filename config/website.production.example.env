# 官网源码仓库。仓库内必须同时存在 loumai-landlord 与同级 loumai-ui。
SITE_REPO=/absolute/path/to/guanwang

# 官网服务器。只填写 SSH 用户和主机，不填写密码或私钥内容。
SITE_DEPLOY_TARGET=ubuntu@132.232.220.115
SITE_SSH_PORT=22
SITE_SSH_IDENTITY_FILE=/absolute/path/to/ssh-private-key

# 正式官网域名。不得填写 test.yinlizhangyu.com。
SITE_PUBLIC_URL=https://yinlizhangyu.com
SITE_WWW_DOMAIN=www.yinlizhangyu.com
SITE_EXPECTED_IPV4=132.232.220.115
SITE_ICP_NUMBER=蜀ICP备2026032754号-1

# 真实客户线索 POST 接口。留空时表单会明确提示失败，不会伪装成提交成功。
# SITE_LEAD_ENDPOINT=https://api.yinlizhangyu.com/api/v1/leads
SITE_LEAD_ENDPOINT=

# 发布门禁。
SITE_EXPECTED_BRANCH=main
SITE_REQUIRE_UPSTREAM_MATCH=true

# 官网使用独立目录和独立服务器 helper，禁止复用 /srv/loumai-h5。
SITE_REMOTE_ROOT=/srv/workway-site
SITE_REMOTE_HELPER=/usr/local/sbin/workway-site-release

# 可留空；留空时 Certbot 使用无邮箱注册。
SITE_CERTBOT_EMAIL=
