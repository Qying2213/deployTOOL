# Production-only server configuration. Install as /etc/loumai/h5-release.env on the
# production host, keep it root-owned (0644 or stricter), and do not share its root
# or public URL with test.
LOUMAI_H5_ENVIRONMENT=production
LOUMAI_H5_REMOTE_ROOT=/srv/loumai-h5-production
LOUMAI_H5_STAGING_ROOT=/srv/loumai-h5-production/incoming
LOUMAI_H5_DEPLOY_USER=loumai-deploy
LOUMAI_H5_PUBLIC_URL=https://h5.example.com
LOUMAI_H5_WEB_USER=www-data
LOUMAI_H5_NGINX_BIN=/usr/sbin/nginx
