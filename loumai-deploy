#!/usr/bin/env bash

set -euo pipefail

TOOL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="${1:-}"

case "${TARGET}" in
  production)
    shift
    exec node "${TOOL_ROOT}/production-release.mjs" "$@"
    ;;
  admin)
    shift
    exec node "${TOOL_ROOT}/admin-release.mjs" "$@"
    ;;
  frontend)
    shift
    exec node "${TOOL_ROOT}/frontend/h5-release.mjs" "$@"
    ;;
  backend)
    shift
    exec node "${TOOL_ROOT}/backend/backend-release.mjs" "$@"
    ;;
  admin-backend)
    shift
    exec node "${TOOL_ROOT}/admin-backend/admin-backend-release.mjs" "$@"
    ;;
  admin-frontend)
    shift
    exec node "${TOOL_ROOT}/admin-frontend/admin-frontend-release.mjs" "$@"
    ;;
  website)
    shift
    exec node "${TOOL_ROOT}/website/site-release.mjs" "$@"
    ;;
  help|-h|--help|"")
    cat <<'EOF'
工位有方统一部署工具

用法：
  ./loumai-deploy production preflight
  ./loumai-deploy production status
  ./loumai-deploy production deploy --dry-run
  ./loumai-deploy production deploy --yes

  ./loumai-deploy admin prepare --env production --yes
  ./loumai-deploy admin deploy --env production --file /absolute/path/admin-production.zip --dry-run
  ./loumai-deploy admin deploy --env production --file /absolute/path/admin-production.zip --yes
  ./loumai-deploy admin status --env production

  ./loumai-deploy frontend build --env test
  ./loumai-deploy frontend deploy --env test --dry-run
  ./loumai-deploy frontend deploy --env test --yes
  ./loumai-deploy frontend deploy --env production --dry-run
  ./loumai-deploy frontend deploy --env production --yes
  ./loumai-deploy frontend deploy-package --file /absolute/path/web.zip --env test --dry-run
  ./loumai-deploy frontend deploy-package --file /absolute/path/web.zip --env test --yes
  ./loumai-deploy frontend status
  ./loumai-deploy frontend status --env production
  ./loumai-deploy frontend rollback --release RELEASE_ID --dry-run
  ./loumai-deploy frontend rollback --release RELEASE_ID --yes

  ./loumai-deploy backend build
  ./loumai-deploy backend env-audit --env test
  ./loumai-deploy backend env-audit --env test --all
  ./loumai-deploy backend deploy --dry-run
  ./loumai-deploy backend deploy --yes
  ./loumai-deploy backend deploy-cloud --dry-run
  ./loumai-deploy backend deploy-cloud --yes
  ./loumai-deploy backend deploy-cloud --sync-helper --yes
  ./loumai-deploy backend sync-helper --env test --yes
  ./loumai-deploy backend env-audit --env production
  ./loumai-deploy backend bootstrap --env production --dry-run
  ./loumai-deploy backend bootstrap --env production --yes
  ./loumai-deploy backend deploy --env production --dry-run
  ./loumai-deploy backend deploy --env production --yes
  ./loumai-deploy backend status
  ./loumai-deploy backend status --env production
  ./loumai-deploy backend status --database-profile cloud
  ./loumai-deploy backend rollback --release RELEASE_ID --yes --ack-db-schema-compatible
  ./loumai-deploy backend rollback --env production --release RELEASE_ID --yes --ack-db-schema-compatible

  ./loumai-deploy admin-backend build
  ./loumai-deploy admin-backend prepare --yes
  ./loumai-deploy admin-backend deploy --dry-run
  ./loumai-deploy admin-backend deploy --yes
  ./loumai-deploy admin-backend status
  ./loumai-deploy admin-backend rollback --release RELEASE_ID --yes
  ./loumai-deploy admin-backend deploy --env production --yes
  ./loumai-deploy admin-backend status --env production
  ./loumai-deploy admin-backend restart --env production --yes
  ./loumai-deploy admin-backend rollback --env production --release RELEASE_ID --ack-db-schema-compatible --yes

  ./loumai-deploy admin-frontend check-package --file /absolute/path/admin.zip
  ./loumai-deploy admin-frontend deploy-package --file /absolute/path/admin.zip --dry-run
  ./loumai-deploy admin-frontend deploy-package --file /absolute/path/admin.zip --yes
  ./loumai-deploy admin-frontend prepare --yes
  ./loumai-deploy admin-frontend status
  ./loumai-deploy admin-frontend rollback --release RELEASE_ID --yes
  ./loumai-deploy admin-frontend deploy-package --env production --file /absolute/path/admin-production.zip --yes
  ./loumai-deploy admin-frontend status --env production

  ./loumai-deploy website build
  ./loumai-deploy website prepare --yes
  ./loumai-deploy website enable-https --yes
  ./loumai-deploy website deploy --yes
  ./loumai-deploy website status
  ./loumai-deploy website rollback --release RELEASE_ID --dry-run
  ./loumai-deploy website rollback --release RELEASE_ID --yes
EOF
    ;;
  *)
    printf '未知目标：%s（只能是 production、frontend、backend、admin、admin-backend、admin-frontend 或 website）\n' "${TARGET}" >&2
    exit 2
    ;;
esac
