[Unit]
Description=Workway public property website read-only API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=loumai-website
Group=loumai-website
WorkingDirectory=/srv/loumai-public-website/current/backend
EnvironmentFile=/etc/loumai-public-website/website.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/loumai-public-website/current/backend/.venv/bin/python -m uvicorn app.public_website_main:app --host 127.0.0.1 --port 8011 --workers 1 --limit-concurrency 48 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
CPUQuota=100%
MemoryMax=768M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
