# Real values are generated on the production server, never uploaded from a local .env.
APP_ENVIRONMENT=public_website
PUBLIC_WEBSITE_ENABLED=true
DATABASE_URL=postgresql+psycopg://loumai_backup:EXAMPLE@db.example:5432/loumai_production?sslmode=verify-full&sslrootcert=/etc/loumai-public-website/db-ca.pem&options=-c%20default_transaction_read_only%3Don%20-c%20statement_timeout%3D8000%20-c%20lock_timeout%3D2000
BACKEND_ALLOWED_HOSTS='["yinlizhangyu.com","www.yinlizhangyu.com","localhost","127.0.0.1"]'
API_DOCS_ENABLED=false
ALLOW_INSECURE_TEST_SETTINGS=false
ALLOW_MOCK_WECHAT=false
AI_ENABLED=false
DEEPSEEK_ENABLED=false
TENCENT_IM_ENABLED=false
FILE_STORAGE_PROVIDER=tencent_cos
TENCENT_COS_SECRET_ID=EXAMPLE
TENCENT_COS_SECRET_KEY=EXAMPLE
TENCENT_COS_REGION=EXAMPLE
TENCENT_COS_BUCKET=EXAMPLE
IMAGE_VARIANTS_ENABLED=true
IMAGE_DIRECT_DOWNLOAD_ENABLED=false
VIDEO_TRANSCODE_ENABLED=true
VIDEO_DIRECT_DOWNLOAD_ENABLED=false
VIDEO_TRANSCODE_WORKER_ID=public-website-readonly
VIDEO_MEDIA_TICKET_SECRET_KEY=INDEPENDENT_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
